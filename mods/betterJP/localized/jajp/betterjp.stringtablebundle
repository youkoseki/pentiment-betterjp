                },
                {
                    "ID": 150,
                    "DefaultText": "粉屋には言ってみたか？"
                },
                {
                    "ID": 154,
                    "DefaultText": "<shake>絶対ダメだ！</shake>"
                },
                {
                    "ID": 155,
                    "DefaultText": "<frantic>二度と</frantic>奴と話すなよ！"
                },
                {
                    "ID": 156,

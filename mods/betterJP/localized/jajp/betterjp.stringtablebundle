        {
            "Name": "conversations/act2/act2_rudeger",
            "UObjectName": "act2_rudeger_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 6,
                    "DefaultText": "ああ、またお会い出来て嬉しいです！ 最近のニュルンベルクはどんな感じですか？"
                },
                {
                    "ID": 25,
                    "DefaultText": "ほお！ 興味深いですね！"
                },

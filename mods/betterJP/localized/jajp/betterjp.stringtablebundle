        {
            "Name": "conversations/act2/act2_muller_meal",
            "UObjectName": "act2_muller_meal_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "マーラー先生。ご一緒していただけて嬉しいです。それで、そちらは...？"
                },
                {
                    "ID": 2,
                    "DefaultText": "我が家の夕食に来てくれてありがとう、マーラー先生。"
                },
                {
                    "ID": 12,
                    "DefaultText": "自分で仕留めた獲物を味わう満足感に勝るものはないな。"
                },
                {
                    "ID": 14,
                    "DefaultText": "しかし、タッシングの話はもういい。どうやってそれだけの財産を築いた？ ニュルンベルクでの生活はどんなものなんだ？"
                },
                {
                    "ID": 16,
                    "DefaultText": "...<red>主</red>は本当に、奴らをちゃんとした思考回路をあたえなかった、<red>だろう</red>？"
                },
                {
                    "ID": 17,
                    "DefaultText": "今晩のためにあたしが準備したもの全部楽しんでいただけると幸いだよ。レンハルト、食事の前に祈ってくれるかい？"
                },
                {
                    "ID": 18,
                    "DefaultText": "他の誰がするんだ、お前か？ パウロか？ 我らが客人かい？"
                },
                {
                    "ID": 19,
                    "DefaultText": "ごめんなさい、レンハルト、マーラー先生。お許しください。"
                },
                {
                    "ID": 21,
                    "DefaultText": "<whisper>そうよね、夢中になってる...</whisper>"
                },
                {
                    "ID": 22,
                    "DefaultText": "あんたもお父さんがどれだけ忙しいか知ってるでしょ、パウロ。レンハルトはいつだって何かに取り組んでいるんだから。"
                },
                {
                    "ID": 25,
                    "DefaultText": "わかっているよ。放浪する芸術家...しかも当時は親方ですらなかったんだ...それでは君の興味を引けなかったわけさ。"
                },
                {
                    "ID": 26,
                    "DefaultText": "[黙り続ける]"
                },
                {
                    "ID": 27,
                    "DefaultText": "今は風車があるおかげで管理ははるかに簡単になったよ。バイエルンでは唯一の風車なのさ。"
                },
                {
                    "ID": 28,
                    "DefaultText": "アンドレアス、よしてくれ。それは昔のことだ。あの頃は仕事ばかりで、楽しませられなかっただろうしな。"
                },
                {
                    "ID": 42,
                    "DefaultText": "ニュルンベルクに残してきた注文があるんだが...需要が増えたことで、ややこしくなってしまってね。"
                },
                {
                    "ID": 43,
                    "DefaultText": "工房を開いてね、ニュルンベルクでは妻と二人で悠々自適に暮らしているよ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "もちろん、パウロのことはもっと優秀な人間になるよう育てている。あいつにははるかに高い目標があるようでね。"
                },
                {
                    "ID": 49,
                    "DefaultText": "ありがたいが、私は自分の作品の方が好きなんだ。"
                },
                {
                    "ID": 50,
                    "DefaultText": "[黙り続ける]"
                },
                {
                    "ID": 52,
                    "DefaultText": "パウロ、君は何をしたいんだい？"
                },
                {
                    "ID": 58,
                    "DefaultText": "あなたのようになりたいんです、マーラー先生！ 僕、教会で絵画を見るのが好きで、いつかあんな風に絵を描けるようになりたいんです。"
                },
                {
                    "ID": 60,
                    "DefaultText": "始めるには少し遅いかもですが、マーラー先生、僕は芸術家になれると思いますか？"
                },
                {
                    "ID": 61,
                    "DefaultText": "もちろんなれるよ、パウロ。私もこの職業にたどり着いたのは、かなり年を取ってからなんだ。"
                },
                {
                    "ID": 62,
                    "DefaultText": "親方画家になるには、長い時間と長年の修業が必要になるけど、君ならきっとなれると思うよ。"
                },
                {
                    "ID": 63,
                    "DefaultText": "それが君にとって最適な職業かどうかはわからないよ、パウロ。"
                },
                {
                    "ID": 64,
                    "DefaultText": "ああ、そうだよな。父親を捨てていけ、パウロ。俺がお前のために、家族のためにしてやったこと全部に唾を吐きかけてな。"
                },
                {
                    "ID": 65,
                    "DefaultText": "レンハルト、パウロはアンドレアスの職業や作品への敬意を表しているだけよ。本気で言ってるわけじゃ..."
                },
                {
                    "ID": 68,
                    "DefaultText": "パウロ、誰もが芸術に興味を持っていいと思うんだ。タッシングでも芸術を追い求める方法を見つけられるはずだ。"
                },
                {
                    "ID": 70,
                    "DefaultText": "お父さんの言うことを聞くべきだよ、パウロ。"
                },
                {
                    "ID": 71,
                    "DefaultText": "息子が不躾な振舞いをして、すまなかったな。"
                },
                {
                    "ID": 72,
                    "DefaultText": "とにかく、あんたがタッシングに戻ってきてくれて嬉しいよ。最低でもまともな会話ってものができたしな。"
                },
                {
                    "ID": 73,
                    "DefaultText": "アンドレアス、本当に、俺と一緒に狩りに行ってみた方がいい。忘れられない日になると約束するよ。"
                },
                {
                    "ID": 75,
                    "DefaultText": "時間を割くわけにはいかないんだ、レンハルト。"
                },
                {
                    "ID": 91,
                    "DefaultText": "問題なのは農民だとは思わないが。"
                },
                {
                    "ID": 97,
                    "DefaultText": "なんだって？ パウロ、お前はよりにもよって大修道院長様に対して、何がキリスト教徒らしくないのかお教えするってのか？"
                },
                {
                    "ID": 100,
                    "DefaultText": "パウロは自分の意見でなく、ウルリッヒの意見について話していたんだと思うんだが。"
                },
                {
                    "ID": 101,
                    "DefaultText": "パウロは、父親譲りの的確な考え方をするね。"
                },
                {
                    "ID": 102,
                    "DefaultText": "[黙り続ける]"
                },
                {
                    "ID": 110,
                    "DefaultText": "は！ そうかもしれないな..."
                },
                {
                    "ID": 111,
                    "DefaultText": "いいだろう。どうせ俺はもう十分話したし、これ以上無駄口を叩いて仕事の邪魔をするわけにはいかないよな、アンドレアス。"
                },
                {
                    "ID": 112,
                    "DefaultText": "さて、俺はもう十分話したし、これ以上無駄口を叩いて仕事の邪魔をするわけにはいかないよな、アンドレアス。"
                },
                {
                    "ID": 113,
                    "DefaultText": "気が変わったら、一言言ってくれ。手配は俺が行うからよ。"
                },
                {
                    "ID": 121,
                    "DefaultText": "ありがとうよ、アンドレアス。わかったろ？ マーラー先生も俺と同じ意見だ。"
                },
                {
                    "ID": 123,
                    "DefaultText": "なるほど、キャスパー。ようこそ、ようこそ。"
                },
                {
                    "ID": 138,
                    "DefaultText": "我が家の夕食に来てくれてありがとう、マーラー先生。"
                },
                {
                    "ID": 143,
                    "DefaultText": "それは...合法なのかい？ オーバーバイエルンでは厳しく制限されていると思っていたのだが。"
                },
                {
                    "ID": 144,
                    "DefaultText": "私は殺人犯を探し出そうとしているんだ、知っているだろう。"
                },
                {
                    "ID": 160,
                    "DefaultText": "町を...兵士たちに囲まれているのに？ 安全なのかい？"
                },
                {
                    "ID": 162,
                    "DefaultText": "助けになるのなら、俺が知っていることを話すことはできる。で、俺はかなり詳しいんだ。"
                },
                {
                    "ID": 171,
                    "DefaultText": "素晴らしい。"
                }
            ]
        },
        {
            "Name": "conversations/act2/act2_monks_meal",
            "UObjectName": "act2_monks_meal_BaseGame_jajp",
            "Entries": [
                {

        {
            "Name": "conversations/act1/act1_kids_saltmine",
            "UObjectName": "act1_kids_saltmine_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 2,
                    "DefaultText": "カ...カエル。"
                },
                {
                    "ID": 3,
                    "DefaultText": "<shake>カエルだよ！</shake>"
                },
                {
                    "ID": 4,
                    "DefaultText": "こんにちは、パウロ。"
                },
                {
                    "ID": 5,
                    "DefaultText": "君はパウロ？ 粉屋の息子さんだね。"
                },
                {
                    "ID": 6,
                    "DefaultText": "君はここで何をしているのかな？"
                },
                {
                    "ID": 7,
                    "DefaultText": "川沿いでは、見つけられないのかい？"
                },
                {
                    "ID": 8,
                    "DefaultText": "それは何？"
                },
                {
                    "ID": 10,
                    "DefaultText": "私は探してるわ！"
                },
                {
                    "ID": 11,
                    "DefaultText": "ぼくも！"
                },
                {
                    "ID": 13,
                    "DefaultText": "君の本当の目的を教えてくれないか？"
                },
                {
                    "ID": 16,
                    "DefaultText": "君のご両親は君がここにいることを知っているの？"
                },
                {
                    "ID": 17,
                    "DefaultText": "...う、うん？"
                },
                {
                    "ID": 18,
                    "DefaultText": "知らないよ！"
                },
                {
                    "ID": 20,
                    "DefaultText": "厄介って？"
                },
                {
                    "ID": 22,
                    "DefaultText": "<shake>ね？</shake>"
                },
                {
                    "ID": 27,
                    "DefaultText": "石を投げてるんだ！"
                },
                {
                    "ID": 28,
                    "DefaultText": "<shake>バート！</shake>"
                },
                {
                    "ID": 29,
                    "DefaultText": "穴の中に石を入れるの！"
                },
                {
                    "ID": 31,
                    "DefaultText": "小さくないわ。ちぎりパンの腕ねってママが言ってたわ！"
                },
                {
                    "ID": 32,
                    "DefaultText": "でっかいちぎりパンの腕だ！"
                },
                {
                    "ID": 34,
                    "DefaultText": "君たち、古い鉱山に石を投げてるの？"
                },
                {
                    "ID": 35,
                    "DefaultText": "...多分そう。"
                },
                {
                    "ID": 36,
                    "DefaultText": "遠くまで落ちて行ってる感じかな？ 穴のそばに寝っ転がると、下の方で「<green>ポロン！</green>」って音が聞こえるんだよ。"
                },
                {
                    "ID": 40,
                    "DefaultText": "一番底には何があると思う？"
                },
                {
                    "ID": 41,
                    "DefaultText": "石よ！"
                },
                {
                    "ID": 42,
                    "DefaultText": "...石の他には？"
                },
                {
                    "ID": 43,
                    "DefaultText": "その穴を降りていこうって考えたことはないの？"

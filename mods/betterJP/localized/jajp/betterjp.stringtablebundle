        {
            "Name": "conversations/act1/act1_else",
            "UObjectName": "act1_else_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "こんにちは、マーラー先生。"
                },
                {
                    "ID": 14,
                    "DefaultText": "アンドレアス・マーラー、親方画家です。"
                },
                {
                    "ID": 16,
                    "DefaultText": "傷ついたな！ アンドレアスと呼んでくれ。"
                },
                {
                    "ID": 18,
                    "DefaultText": "エルゼとお呼びしても？"
                },
                {
                    "ID": 19,
                    "DefaultText": "<whisper>夫に聞こえないところでお願いね。</whisper>"
                },
                {
                    "ID": 20,
                    "DefaultText": "クララとエヴァのところに、芸術家の方が下宿していると聞いたわ。きっと楽しいでしょうね。"
                },
                {
                    "ID": 21,
                    "DefaultText": "ちょっとふざけただけさ。"
                },
                {
                    "ID": 26,
                    "DefaultText": "[ニヤリと笑う] 彼女らにとって？ それとも私にとって？"
                },
                {
                    "ID": 27,
                    "DefaultText": "マーラー先生！"
                },
                {
                    "ID": 28,
                    "DefaultText": "あの、ただ...農場で町の人たちに囲まれて暮らすのは、という意味だったの。"
                },
                {
                    "ID": 29,
                    "DefaultText": "賑やかでしょ？"
                },
                {
                    "ID": 30,
                    "DefaultText": "ええ、ペテロが粉屋の挽き賃のことでまくし立てているときくらいだね。"
                },
                {
                    "ID": 31,
                    "DefaultText": "でも、ウルスラがいてくれるおかげで、家の中が明るいよ。"
                },
                {
                    "ID": 39,
                    "DefaultText": "クララよりもエヴァが、でしょ？"
                },
                {
                    "ID": 41,
                    "DefaultText": "わかったよ。ご迷惑をおかけしたね。では失礼、ミュレリン夫人。"
                },
                {
                    "ID": 45,
                    "DefaultText": "息子さんのパウロと話したよ。いい子そうだ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "[何も言わない]"
                },
                {
                    "ID": 47,
                    "DefaultText": "パウロはかわいい子よ。でも、すごく恥ずかしがり屋で..."
                },
                {
                    "ID": 48,
                    "DefaultText": "いいえ！"
                },
                {
                    "ID": 50,
                    "DefaultText": "何がいけないんだ？ 旦那さんは嫉妬深いのかい？"
                },
                {
                    "ID": 53,
                    "DefaultText": "ええ...でも、そんなに旅行はしていないの？ 芸術家は修行の旅に出るものよね？"
                },
                {
                    "ID": 54,
                    "DefaultText": "あら、こんなにお若いのに親方なのね？ それは...すばらしいわ。"
                },
                {
                    "ID": 55,
                    "DefaultText": "その、正確にはまだ親方ではないが...大作を仕上げている最中なんだ。"
                },
                {
                    "ID": 57,
                    "DefaultText": "それはどういった...ものなの？"
                },
                {
                    "ID": 62,
                    "DefaultText": "ああ、夢を実現させること、ね..."
                },
                {
                    "ID": 65,
                    "DefaultText": "ああ、失礼、紹介がまだだった。君はエルゼ・ミュレリンだね？"
                },
                {
                    "ID": 66,
                    "DefaultText": "ええと、粉屋の奥さんだね？"
                },
                {
                    "ID": 67,
                    "DefaultText": "エルゼ・ミュレリン、そうよ。ああ...<whisper>これは失礼しました...</whisper>"
                },
                {
                    "ID": 69,
                    "DefaultText": "君は粉屋の奥さんだね？"
                },
                {
                    "ID": 78,
                    "DefaultText": "私はパウロの世話をしないと。あの子は本当に恥ずかしがり屋で..."
                },
                {
                    "ID": 80,
                    "DefaultText": "彼は、自分の身に何かが起きてしまう前に、余計な詮索はやめた方がいいね。"
                },
                {
                    "ID": 84,
                    "DefaultText": "権利？ ...私には世話をする家族がいるわ。レンハルト。<whisper>パウロ、私のかわいい天使...</whisper>"
                },
                {
                    "ID": 91,
                    "DefaultText": "<red>後生だから</red>そんなことは言わないで。お願い、はしたないわ。"
                },
                {
                    "ID": 98,
                    "DefaultText": "アンドレアス！"
                },
                {
                    "ID": 99,
                    "DefaultText": "<frantic>エルゼ！</frantic>"
                },
                {
                    "ID": 100,
                    "DefaultText": "おしゃべりは終わったか？ 仕事が残ってるんだぞ！"
                },
                {
                    "ID": 102,
                    "DefaultText": "あ、マーラー先生。こんにちは。"
                },
                {
                    "ID": 103,
                    "DefaultText": "息子さんのパウロのことだ。あの子が古い塩山の近くで遊んでいるのを見かけた。"
                },
                {
                    "ID": 105,
                    "DefaultText": "何か私にできることはあるかしら？ <whisper>手短にお願いできる？</whisper>"
                },
                {
                    "ID": 110,
                    "DefaultText": "あの子は何をしていたんです？"
                },
                {
                    "ID": 114,
                    "DefaultText": "パウロはグロッシェンを期待していた。何かを心配しているみたいだったよ。"
                },
                {
                    "ID": 115,
                    "DefaultText": "あの子はコインを集めているのか？ ローマの硬貨を？"
                },
                {
                    "ID": 116,
                    "DefaultText": "家計は大丈夫なのかい？"
                },
                {
                    "ID": 120,
                    "DefaultText": "パウロが気づいていたとは思わなかったわ。内職の事を...あの子に話すわ。きちんと説明するの。"
                },
                {
                    "ID": 121,
                    "DefaultText": "教えてくれてありがとう、マーラー先生。もう行かないと。"
                },
                {
                    "ID": 123,
                    "DefaultText": "ご家族は大丈夫なのか？"
                },
                {
                    "ID": 128,
                    "DefaultText": "パウロは注意深い子なの。私がくよくよしているのを見て、お金のせいだと思ったのね。"
                }
            ]
        },
        {

        {
            "Name": "conversations/act2/act2_ferenc",
            "UObjectName": "act2_ferenc_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 2,
                    "DefaultText": "アンドレアス。あれから何年も経ったが、こうして再会できてうれしいぞ。"
                },
                {
                    "ID": 3,
                    "DefaultText": "<frantic>君か。</frantic>"
                },
                {
                    "ID": 6,
                    "DefaultText": "私がいなくて寂しく思っているのですか？"
                },
                {
                    "ID": 10,
                    "DefaultText": "突然話題を変えてしまって申し訳ありませんが、この本について何かご存じですか？"
                },
                {
                    "ID": 11,
                    "DefaultText": "そろそろ失礼します。お会いできてよかったです。"
                },
                {
                    "ID": 12,
                    "DefaultText": "ああ...え？"
                },
                {
                    "ID": 13,
                    "DefaultText": "それには<blue>疑わしい</blue>儀式が含まれているのです。"
                },
                {
                    "ID": 14,
                    "DefaultText": "どこで見つけたのだ？ 図書館ではないといいのだが。"
                },
                {
                    "ID": 18,
                    "DefaultText": "ああ、そんな。どうして彼がそんなことをするというのだ？！"
                },
                {
                    "ID": 24,
                    "DefaultText": "ああ、そうだ...写字室と図書館は、努力したものの、同じ幸運には恵まれなかった。"
                },
                {
                    "ID": 26,
                    "DefaultText": "まあ...ピエロ修道士のことは気の毒だった。君たち二人が仲良くしていたことは分かっていたぞ。"
                },
                {
                    "ID": 27,
                    "DefaultText": "あれは苦しい日々でした。"
                },
                {
                    "ID": 28,
                    "DefaultText": "写字室での作業を監督した重圧で、私に宿る罪と憎しみの傷が刺激されてしまったようだ。"
                },
                {
                    "ID": 29,
                    "DefaultText": "俗人が居合わせたことで、私の苛立ちはいっそう募ったのだ。もちろん、君のせいではない。"
                },
                {
                    "ID": 37,
                    "DefaultText": "「時はすべての必要悪を癒してくれる」"
                },
                {
                    "ID": 38,
                    "DefaultText": "古典への愛は失っていないようだな。"
                },
                {
                    "ID": 40,
                    "DefaultText": "ここ数年、どうされていたんです？"
                },
                {
                    "ID": 45,
                    "DefaultText": "写字室の運営が要らなくなったおかげで、小修道院長として修道士たちのために、効率よく働けるようになったのだ。"
                },
                {
                    "ID": 50,
                    "DefaultText": "しばらくの間は気にかかっていたが、あれは悪魔の仕業に手を貸した、私の高慢のせいだったと思う。"
                },
                {
                    "ID": 54,
                    "DefaultText": "それは私やマチュー修道士をはるかに超えている。"
                },
                {
                    "ID": 55,
                    "DefaultText": "私は、大修道院長がガイ修道士の技能を存分に活かしておられることに満足しているのだ。"
                },
                {
                    "ID": 57,
                    "DefaultText": "ええ。しおりの挟まれた箇所には、人を殺すために悪魔を召喚する方法が書かれていました。"
                },
                {
                    "ID": 59,
                    "DefaultText": "その日はいずれ来ると決まっていたのだ。あれだけ長く続いたことのほうが、むしろ驚きだ。"
                },
                {
                    "ID": 70,
                    "DefaultText": "<red>神</red>よ、我らをお守りください！"
                },
                {
                    "ID": 71,
                    "DefaultText": "彼がオットーの死に関わっていたとは思っておらぬだろうな？"
                },
                {
                    "ID": 83,
                    "DefaultText": "ロスフォーゲル男爵が殺された時、大助祭は君の言葉を信用した。"
                },
                {
                    "ID": 87,
                    "DefaultText": "もし農民が君の言葉を信じれば、その言葉は命取りになるだろう。"
                },
                {
                    "ID": 96,
                    "DefaultText": "もう小修道院長ではない、マーラー殿。小修道院長ではないのだ。"
                },
                {
                    "ID": 97,
                    "DefaultText": "君が、大助祭に向かって私の評判を<frantic>貶めた</frantic>からな。"
                },
                {
                    "ID": 98,
                    "DefaultText": "君がキアサウを去った後、ゲルノット神父は私を解任し、マチュー修道士を小修道院長に任命したのだ。"
                },
                {
                    "ID": 99,
                    "DefaultText": "君が私にやったことで、<green>毎日</green>君に悪意を抱かないように努めるのは、キリスト教徒としての魂を試されることなのだ。"
                },
                {
                    "ID": 100,
                    "DefaultText": "<red>私</red>が<red>あなた</red>に一体何をしたと言うのですか？"
                },
                {
                    "ID": 102,
                    "DefaultText": "君は、大助祭に向かって私の評判を<frantic>貶めた</frantic>んだ。"
                },
                {
                    "ID": 103,
                    "DefaultText": "<shake>感謝</shake>だと？！"
                },
                {
                    "ID": 108,
                    "DefaultText": "そんなことはどうでもいい、マーラー殿！"
                },
                {
                    "ID": 109,
                    "DefaultText": "君自身の行動が他者に与える影響について<frantic>考えた</frantic>ことすらないと言うのか？"
                },
                {
                    "ID": 114,
                    "DefaultText": "君は本当に<green>酷い</green>ちっぽけな男だ、アンドレアス・マーラー。"
                },
                {
                    "ID": 116,
                    "DefaultText": "私は実践したから<shake>捕まったのではない</shake>！ 私は誤った本を読んだことを非難されたんだ。"
                },
                {
                    "ID": 117,
                    "DefaultText": "君の<red>噂話</red>のせいで非難されたんだ！"
                },
                {
                    "ID": 118,
                    "DefaultText": "私は殺人事件を解決しようとしていただけだ！ あなたの行動が関係ありそうだったから。"
                },
                {
                    "ID": 120,
                    "DefaultText": "君には全てがお遊びなんだな。人生そのものが冗談なのか。"
                },
                {
                    "ID": 121,
                    "DefaultText": "なら、修道女が命を失ったとしたら？"
                },
                {
                    "ID": 122,
                    "DefaultText": "なら、町の石工が命を落としたとしたら？"
                },
                {
                    "ID": 123,
                    "DefaultText": "なら、年老いた未亡人が命を失ったとしたら？"
                },
                {
                    "ID": 124,
                    "DefaultText": "なら、大修道院長の目から見た私の立場を台無しにしたとしたら？"
                },
                {
                    "ID": 125,
                    "DefaultText": "そもそも男爵殺しの犯人が正しかったかどうかを気にしたことがあるのか？"
                },
                {
                    "ID": 126,
                    "DefaultText": "これはその結果の一つだ。君は満足しているのか？"
                },
                {
                    "ID": 133,
                    "DefaultText": "断罪されなかった<red>君は</red>幸運だったな。"
                },
                {
                    "ID": 135,
                    "DefaultText": "だろうな。大助祭には好きに言えばいいさ。"
                },
                {
                    "ID": 138,
                    "DefaultText": "よくやった、マーラー殿。"
                },
                {
                    "ID": 139,
                    "DefaultText": "私がそのことに感謝するとでも思っているのか？！"
                },
                {
                    "ID": 140,
                    "DefaultText": "いや、関係なかった、なぜなら大助祭は私を男爵の殺人で裁かなかったのだから。"
                },
                {
                    "ID": 145,
                    "DefaultText": "つもりがあろうとなかろうと、そうなったのだ。君にはそれでよかったのだろう？"
                },
                {
                    "ID": 147,
                    "DefaultText": "ああそうとも、君のせいではないな。君とは関係あるまい。"
                },
                {
                    "ID": 150,
                    "DefaultText": "君を<frantic>憎む</frantic>ことへの罪悪感を。"
                },
                {
                    "ID": 151,
                    "DefaultText": "私は君を赦せるだろう。赦さなくてはいけない。"
                },
                {
                    "ID": 153,
                    "DefaultText": "自分の行いには自分で責任を持つ。君に対して怒りを抱いたのは見当違いだった。私は君を赦す。"
                },
                {
                    "ID": 157,
                    "DefaultText": "無理を言って申し訳ありませんが、私が見つけた本を見ていただけないでしょうか？"
                },
                {
                    "ID": 159,
                    "DefaultText": "君もな、マーラー殿。"
                },
                {
                    "ID": 160,
                    "DefaultText": "何か手伝えることはあるか、マーラー殿？"
                },
                {
                    "ID": 164,
                    "DefaultText": "私たちの状況と直面している危機を考えても、君の存在は歓迎すべきものだ。"
                },
                {
                    "ID": 165,
                    "DefaultText": "オットー・ツィンマーマンが殺害された時、君が何らかの形で関わっていることに気づくべきだったな。"
                }
            ]
        },

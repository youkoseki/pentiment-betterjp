        {
            "Name": "conversations/act1/act1_gernot_pre_questioning",
            "UObjectName": "act1_gernot_pre_questioning_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "失礼。大助祭に頼まれて来たんだ。"
                },
                {
                    "ID": 6,
                    "DefaultText": "マーラー殿。ここ数日君が大修道院で何をしていたか知らないと思っているなら、大間違いだ。"
                },
                {
                    "ID": 7,
                    "DefaultText": "と言うと？"
                },
                {
                    "ID": 11,
                    "DefaultText": "君がケンパリン未亡人を訪ね、賃貸の合法性を問うよう説得したことはわかっている。"
                },
                {
                    "ID": 19,
                    "DefaultText": "君は純真な修練士を使って手伝わせたのだ。恥ずかしくないのか？"
                },
                {
                    "ID": 21,
                    "DefaultText": "<frantic>黙れ！</frantic>"
                },
                {
                    "ID": 24,
                    "DefaultText": "まあ、私が君の冒涜行為を償わせることができなくとも、フォルクベルトは加担したことに苦しむだろう。"
                },
                {
                    "ID": 25,
                    "DefaultText": "恐ろしく狭量だな、神父。感心するよ。"
                },
                {
                    "ID": 27,
                    "DefaultText": "フォルクベルトは子供のような心を持ってる。"
                },
                {
                    "ID": 34,
                    "DefaultText": "よく老女を盗み見ているのか？"
                },
                {
                    "ID": 35,
                    "DefaultText": "だとしたら？ 未亡人を騙そうとしてるだろう。"
                },
                {
                    "ID": 36,
                    "DefaultText": "小さな町では噂はすぐに広まるものだ、マーラー殿。"
                },
                {
                    "ID": 45,
                    "DefaultText": "君とロレンツ・ロスフォーゲルは、似合いの者同士だったわけだ。"
                },
                {
                    "ID": 51,
                    "DefaultText": "フロリアン修道士はベネディクト会の修道士だ。自尊心など元々ない。"
                },
                {
                    "ID": 60,
                    "DefaultText": "面白いか？ マーラー殿。暴力を茶化すとは、私は面白いと思わないが。"
                },
                {
                    "ID": 61,
                    "DefaultText": "お節介を焼いた以上、依頼の仕事が済んだあと、君がキアサウで歓迎されることはない。"
                },
                {
                    "ID": 63,
                    "DefaultText": "何をするつもりだ？ マチューに追い出させる気か？"
                },
                {
                    "ID": 66,
                    "DefaultText": "君の侮蔑の念は、しかと心に留めておく。"
                },
                {
                    "ID": 69,
                    "DefaultText": "もういいか？"
                },
                {
                    "ID": 70,
                    "DefaultText": "申し訳ありません。ただピエロ修道士を助けたかっただけなのです。"
                },
                {
                    "ID": 72,
                    "DefaultText": "邪魔するつもりはありませんでした、大修道院長。"
                },
                {
                    "ID": 74,
                    "DefaultText": "君の処分は大助祭に任せる。偽証しないように"
                },
                {
                    "ID": 75,
                    "DefaultText": "だが私は知っている。そして未亡人の亡き夫の賃貸の法的位置づけが問題かといえば、否だ。"
                },
                {
                    "ID": 76,
                    "DefaultText": "大助祭はなんと言うかな。"
                },
                {
                    "ID": 77,
                    "DefaultText": "じゃあなんでそんなに怒ってるんだ？"
                },
                {
                    "ID": 79,
                    "DefaultText": "ハハ。大助祭にその話を持ち出しただけでも、君は処刑人に鞭打たれることになるだろうな。"
                },
                {
                    "ID": 80,
                    "DefaultText": "神父がもがき苦しむのを見られるなら、それだけの価値はある。"
                },
                {
                    "ID": 81,
                    "DefaultText": "大助祭は神父ほどは堕落してないはずだ。"
                },
                {
                    "ID": 86,
                    "DefaultText": "君の心は恨みと憎しみで満ちているようだな、マーラー殿。"
                }
            ]
        },
        {
            "Name": "conversations/act1/act1_sebhat_meal",
            "UObjectName": "act1_sebhat_meal_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "ああ...アンドレアス。"
                },
                {
                    "ID": 2,
                    "DefaultText": "なんだい？"
                },
                {
                    "ID": 3,
                    "DefaultText": "タッシングのすべての母親とその子供たちがいるのですか？"
                },
                {
                    "ID": 8,
                    "DefaultText": "お話？"
                },
                {
                    "ID": 10,
                    "DefaultText": "僕、お話好きですよ！"
                },
                {
                    "ID": 12,
                    "DefaultText": "ハ！ わかりました。話をしてあげましょう。ですが、祈りを捧げて、食事をするのが先です。"
                },
                {
                    "ID": 24,
                    "DefaultText": "アーメン！"
                },
                {
                    "ID": 29,
                    "DefaultText": "あなたの故郷のお話では？"
                },
                {
                    "ID": 31,
                    "DefaultText": "あたしのウルリッヒはいつも、パンが人々を結びつけると言うんです！"
                },
                {
                    "ID": 36,
                    "DefaultText": "フィレンツェにはパンがないのかい？！"
                },
                {
                    "ID": 37,
                    "DefaultText": "フィレンツェってどこ？"
                },
                {
                    "ID": 39,
                    "DefaultText": "アハハ、ああ、あんたとトマス神父ときたら！ あんた、ライ麦が大好きだよね！"
                },
                {
                    "ID": 40,
                    "DefaultText": "フランドルにはパンがないのかい？！"
                },
                {
                    "ID": 41,
                    "DefaultText": "バーゼルにはパンがないのかい？！"
                },
                {
                    "ID": 42,
                    "DefaultText": "フランドルってどこ？"
                },
                {
                    "ID": 43,
                    "DefaultText": "バーゼルってどこ？"
                },
                {
                    "ID": 48,
                    "DefaultText": "え？！"
                },
                {
                    "ID": 53,
                    "DefaultText": "ゲルノット神父は白パンを食べますね？"
                },
                {
                    "ID": 55,
                    "DefaultText": "どうして？"
                },
                {
                    "ID": 56,
                    "DefaultText": "大修道院長はとても偉いんだよ、パウロ。"
                },
                {
                    "ID": 59,
                    "DefaultText": "あの、材料は何ですか？ もしかしたら、あたしたちで作れるかも！"
                },
                {
                    "ID": 67,
                    "DefaultText": "もう<green>パン</green>のお話したくない。とっても<shake>つまんない</shake>！"
                },
                {
                    "ID": 70,
                    "DefaultText": "あたしらの料理は、ニュルンベルクのお墨付きだよ、お嬢さんたち！"
                },
                {
                    "ID": 71,
                    "DefaultText": "ああ、言いたいことはわかるだろ？"
                },
                {
                    "ID": 72,
                    "DefaultText": "[イライラして答えない]"
                },
                {
                    "ID": 75,
                    "DefaultText": "たしかにお話をすると言いましたね。子供たちよ、そなたたちは聖書を見たことがありますか？"
                },
                {
                    "ID": 78,
                    "DefaultText": "うん！ トマス神父が持ってるよ！ <shake>でっかいんだ！</shake>"
                },
                {
                    "ID": 79,
                    "DefaultText": "わぁ！"
                },
                {
                    "ID": 80,
                    "DefaultText": "わぁ！"
                },
                {
                    "ID": 81,
                    "DefaultText": "わぁ！"
                },
                {
                    "ID": 83,
                    "DefaultText": "よろしい。これは私が大修道院長に渡すために持ってきた、我が故郷からの聖書です。"
                },
                {
                    "ID": 84,
                    "DefaultText": "さて、子供たち、そなたらは<red>イエス</red>が群衆に食べ物を与えた話を知っていますか？"
                },
                {
                    "ID": 85,
                    "DefaultText": "<shake>お魚とパン！</shake>"
                },
                {
                    "ID": 90,
                    "DefaultText": "アンドレアス、聖書の中で、描きたいと思う物語はありますか？"
                },
                {
                    "ID": 98,
                    "DefaultText": "素晴らしい！ 預言者が肉体ごと天に運ばれる光景。"
                },
                {
                    "ID": 106,
                    "DefaultText": "はは、それでも祝福には変わりありません。"
                },
                {
                    "ID": 110,
                    "DefaultText": "どうして皆、茶色なの？"
                },
                {
                    "ID": 114,
                    "DefaultText": "どうして？"
                },
                {
                    "ID": 117,
                    "DefaultText": "セバト修道士、<red><frantic>殺された</frantic></red> <blue>男爵</blue>のことは知っていたんですか？！"
                },
                {
                    "ID": 118,
                    "DefaultText": "バート！"
                },
                {
                    "ID": 127,
                    "DefaultText": "私は彼を知りませんでした、バート。ですが、あなたはラザロの物語をご存じですか？"
                },
                {
                    "ID": 128,
                    "DefaultText": "あぁ...いいえ？"
                },
                {
                    "ID": 133,
                    "DefaultText": "<red>イエス</red>は人を死からよみがえらせることができるんですか？！"
                },
                {
                    "ID": 135,
                    "DefaultText": "おーい！"
                },
                {
                    "ID": 136,
                    "DefaultText": "[何も言わない]"
                },
                {
                    "ID": 140,
                    "DefaultText": "ローマ人でも？"
                },
                {
                    "ID": 143,
                    "DefaultText": "なぜローマ人について聞いたのですか？"
                },
                {
                    "ID": 145,
                    "DefaultText": "どういうこと、パウロ？"
                },
                {
                    "ID": 148,
                    "DefaultText": "パウロ、作り話しはやめなさい。それに夜、外に出るべきじゃないわ。"
                },
                {
                    "ID": 149,
                    "DefaultText": "アンドレアス、彼は何を言ってるのでしょうか？"
                },
                {
                    "ID": 152,
                    "DefaultText": "教会は、霊が肉とは別に存在することを認識しているから...可能性はあるだろう。"
                },
                {
                    "ID": 154,
                    "DefaultText": "なぜそのようなことをするのでしょうか？"
                },
                {
                    "ID": 158,
                    "DefaultText": "この世界には私たちの理解を超えたものがあります、アンドレアス。おそらく少年は...超自然的なものを見たのでしょう。"
                },
                {
                    "ID": 159,
                    "DefaultText": "ああ、奥様方、お詫びします。ですが、今日は私と食事を共にしてくれてありがとうございました。"
                },
                {
                    "ID": 161,
                    "DefaultText": "ありがとうございます、セバト修道士！ 素敵な時間でした。"
                },
                {
                    "ID": 163,
                    "DefaultText": "はい。<red>神</red>があなた方に健康を与えてくださいますように。"
                },
                {
                    "ID": 246,
                    "DefaultText": "ほんと？"
                },
                {
                    "ID": 258,
                    "DefaultText": "先日の夜...似たような何かを見た気がする。"
                },
                {
                    "ID": 259,
                    "DefaultText": "え、本当ですか？ どこで？"
                },
                {
                    "ID": 261,
                    "DefaultText": "ああ...ほら、私はこれ以上話すべきではないだろう。"
                },
                {
                    "ID": 265,
                    "DefaultText": "パウロはある種の魂を見たのかもしれない。"
                }
            ]
        },
        {
            "Name": "conversations/act2/act2_bed_sleep",
            "UObjectName": "act2_bed_sleep_BaseGame_jajp",

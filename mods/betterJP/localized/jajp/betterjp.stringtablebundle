        {
            "Name": "conversations/act1/act1_illpeter",
            "UObjectName": "act1_illpeter_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 6,
                    "DefaultText": "あ、ああ。そう、アンドレアス。"
                },
                {
                    "ID": 29,
                    "DefaultText": "町の人たちに天気をどうこうできるとは思えませんが。"
                },
                {
                    "ID": 31,
                    "DefaultText": "この天気ときたら、<red>神</red>に見放されたようなひどさだ。わしの若い頃から、この町はすっかりダメになっちまった..."
                },
                {
                    "ID": 32,
                    "DefaultText": "お若い頃とは、いろいろと様子が違うのですか？"
                },
                {
                    "ID": 33,
                    "DefaultText": "ああ？ まあ、今のやつらにどうにかできるわけがないさ。誰も古いやり方に従わなくなっちまったからな。"
                },
                {
                    "ID": 34,
                    "DefaultText": "昔の大修道院長は、わしらの風習のことなんぞ、うるさく言わなかったもんだ。"
                },
                {
                    "ID": 36,
                    "DefaultText": "教会は異教の神々を祭ることをことごとく禁じたのです、<xg>イル・ペテロ</xg>。"
                },
                {
                    "ID": 37,
                    "DefaultText": "どんな古い風習ですか？"
                },
                {
                    "ID": 38,
                    "DefaultText": "聖モーリッツがタッシングを守っているのだと思っていました。"
                },
                {
                    "ID": 39,
                    "DefaultText": "誰も風習を守らなくなったから、精霊が天気を悪化させたと思っているのですか？"
                },
                {
                    "ID": 40,
                    "DefaultText": "そうさ、聖サティアもな。だが、聖人たちが来る前は、誰が守っていたと思う？"
                },
                {
                    "ID": 41,
                    "DefaultText": "聖人たちがタッシングを見守った最初の者じゃないんだ。わしの父も知っていたし、老ラニッヒ・ケンパーも知っていた。"
                },
                {
                    "ID": 42,
                    "DefaultText": "魔女を怖がらせて追い払い、精霊がわしらの畑に嵐雲を呼ぶのを防ぐようなやつさ。"
                },
                {
                    "ID": 43,
                    "DefaultText": "まあ、ペルヒタにはそのことを誰も教えなかったようですね。彼女のほうが先にここにいたのですから。"
                },
                {
                    "ID": 44,
                    "DefaultText": "おや！ 見た目よりも鋭いじゃないか、え？"
                },
                {
                    "ID": 45,
                    "DefaultText": "あのろくでなしの大修道院長は気に入らんだろうが、わしらの中には、今も伝統を守り続けている者がいるんだ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "あの年老いた未亡人の、オッティリアのように、ですか？"
                },
                {
                    "ID": 48,
                    "DefaultText": "その伝統とは...具体的にどのようなものなのですか？"
                },
                {
                    "ID": 49,
                    "DefaultText": "夜中に小便に起きたときは、家の右側をぐるっと回って、帰りは絶対に同じ道を通らんことだ。"
                },
                {
                    "ID": 50,
                    "DefaultText": "そうすりゃ、魔女におまえさんの魂を盗られずに済むのさ。"
                },
                {
                    "ID": 51,
                    "DefaultText": "そうそう。あの女はいつも戸口の枠にラベンダーを吊るして、精霊を寄せつけないようにしとるんだ。"
                },
                {
                    "ID": 52,
                    "DefaultText": "へえ。それは...面白いですね。"
                },
                {
                    "ID": 54,
                    "DefaultText": "なるほど。"
                },
                {
                    "ID": 56,
                    "DefaultText": "ん？ そうかい。<red>神</red>のご加護がありますように。"
                },
                {
                    "ID": 57,
                    "DefaultText": "<shake>*ごほっごほっ*</shake>"
                },
                {
                    "ID": 58,
                    "DefaultText": "チッ！ 大修道院だと！"
                },
                {
                    "ID": 59,
                    "DefaultText": "ペルヒタの猟犬が大修道院長など喰ってくれるわい！"
                },
                {
                    "ID": 60,
                    "DefaultText": "そうですね。"
                },
                {
                    "ID": 61,
                    "DefaultText": "ビールと小便くらい違うわい！"
                },
                {
                    "ID": 62,
                    "DefaultText": "空を晴らして天気をよくするために、わしらがペルヒタに少しばかり供え物をしても、あの人は気にしなかったんだ。"
                },
                {
                    "ID": 63,
                    "DefaultText": "マティアスは、白い貴婦人の名がわしらの口をついて出ようとも、<red>キリスト</red>はわしらの心にあると分かってくれておった。"
                },
                {
                    "ID": 64,
                    "DefaultText": "精霊に効かないとしても、いい香りはしますからね。"
                },
                {
                    "ID": 65,
                    "DefaultText": "まあな。だがわしは、幽霊や魔女やその手のものに効くことだけは知っているんだ。"
                }
            ]
        },
        {
            "Name": "conversations/act1/act1_bigjorg",
            "UObjectName": "act1_bigjorg_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "今朝、男が共有地を通っていったよ。大勢の男たちを引き連れてね。きっと大助祭だ。"
                },
                {
                    "ID": 4,
                    "DefaultText": "あんた、そのお偉いさんと話をすることになってるんじゃないのか？ 大助祭と。"
                },
                {
                    "ID": 6,
                    "DefaultText": "クララは夕食に何を作るのかな...アルバン家のパンに、オールド・オットーの魚が少しあれば...魚のためなら何だってするよ..."
                },
                {
                    "ID": 7,
                    "DefaultText": "親父の背中に効く軟膏をもらいに、アグネスのところへ行かないとな。親父は自分じゃ何もしようとしないから。"
                },
                {
                    "ID": 8,
                    "DefaultText": "シスター・ズデーニャは今頃何をしてるかな。へへ。"
                },
                {
                    "ID": 10,
                    "DefaultText": "川が氾濫しないよう、<red>神</red>に祈るよ。農場を失ったら、どうしていいか分からない。"
                },
                {
                    "ID": 11,
                    "DefaultText": "壁を作り直すのに何日もかかりそうだ。親父に手伝ってもらいたいところだけど...親父は休ませないとな。"
                },
                {
                    "ID": 12,
                    "DefaultText": "このままだと大麦がみんな溺れちまう。<red>神様</red>、どうかその雨を、代わりにフランツ・バウアーのところへ降らせてください！"
                },
                {
                    "ID": 14,
                    "DefaultText": "大修道院に行く途中で迷子になるなよ！ ハハハ。"
                },
                {
                    "ID": 15,
                    "DefaultText": "ほらな、嵐が来るって言っただろ。今度のはでかそうだぞ。"
                },
                {
                    "ID": 16,
                    "DefaultText": "明日は一日中降らないといいんだけど。野菜畑の草むしりをしなきゃならないんだ。"
                },
                {
                    "ID": 17,
                    "DefaultText": "よう、アンドレアス。今日は女の子たちに挨拶したかい？"
                },
                {
                    "ID": 18,
                    "DefaultText": "エヴァとクララかい？"
                },
                {
                    "ID": 19,
                    "DefaultText": "いや、鶏のことだよ。<xg>ペテロ</xg>、ヤコブ、ヨハネさ。"
                },
                {
                    "ID": 20,
                    "DefaultText": "鶏に使徒の名前を付けたのかい？"
                },
                {
                    "ID": 21,
                    "DefaultText": "でも、知ってる可愛い子はみんな結婚してるからさ。よその奥さんの名前を鶏につけるのは、どうかと思って。"
                },
                {
                    "ID": 22,
                    "DefaultText": "もっと女の子らしい名前は思いつかなかったのか？ 知り合いの可愛い子の名前とか？"
                },
                {
                    "ID": 23,
                    "DefaultText": "トマス神父には知られないほうがいいぞ。罰当たりにもほどがある。"
                },
                {
                    "ID": 24,
                    "DefaultText": "今朝、ちょうど話したところさ。どうして？"
                },
                {
                    "ID": 25,
                    "DefaultText": "背中を撫でたり、胸の下を掻いてやったりすると、喜ぶんだよ。"
                },
                {
                    "ID": 26,
                    "DefaultText": "でも、毎週日曜のミサで使徒の話を聞くだろう？ 使徒たちは、<red>イエス様</red>の栄光の瞬間も、<red>イエス様</red>の最も暗い試練も見届けたんだ。"
                },
                {
                    "ID": 29,
                    "DefaultText": "地元のきれいな植物の名前じゃだめなのかい？ ヤロー、アイブライト、カンピオンなら似合うと思うよ。"
                },
                {
                    "ID": 30,
                    "DefaultText": "クララにも同じことを言われたよ。俺が不敬だって思ってるんだ。"
                },
                {
                    "ID": 31,
                    "DefaultText": "でも、<xg>ペテロ</xg>、ヤコブ、ヨハネは、<red>イエス様</red>の栄光の瞬間も、最も暗い試練も見届けたんだよ。"
                },
                {
                    "ID": 32,
                    "DefaultText": "それで思ったんだ...女の子たちと俺も、そうなんじゃないかって。あの子たちは、俺がここでやることを全部見てるからさ。"
                },
                {
                    "ID": 33,
                    "DefaultText": "なるほど、ビッグ・ヨルグ。君は<red>キリスト</red>と共通点が多いんだね。"
                },
                {
                    "ID": 34,
                    "DefaultText": "忠告しておくけど、そのことは他の誰にも言わないほうがいい。特に神父にはね。"
                },
                {
                    "ID": 35,
                    "DefaultText": "からかってるんだな。いいよ、分かってる。"
                },
                {
                    "ID": 36,
                    "DefaultText": "いいよ、分かった。これからは「女の子たち」って呼ぶことにするよ。"
                },
                {
                    "ID": 38,
                    "DefaultText": "そういうのは知らなくてね。いつもは色で呼んでるんだ。草原にいるのは黄色いやつで、紫色のは..."
                },
                {
                    "ID": 39,
                    "DefaultText": "それって冒涜じゃないのかい？"
                },
                {
                    "ID": 40,
                    "DefaultText": "そうやってはっきり言われると、そうかもな..."
                },
                {
                    "ID": 41,
                    "DefaultText": "いいよ、分かった。これからは、さっき言った花の名前で呼ぶことにするよ。"
                },
                {
                    "ID": 42,
                    "DefaultText": "これからは、さっき言った花の名前で呼ぶことにするよ。"
                },
                {
                    "ID": 43,
                    "DefaultText": "これからは「女の子たち」って呼ぶことにするよ。"
                },
                {
                    "ID": 44,
                    "DefaultText": "君の家が卵を食べてるのを見たことがない。あれだけの卵をどうしてるんだい？"
                },
                {
                    "ID": 45,
                    "DefaultText": "ああ、バウアー家に売ってるんだ。クララが言うには、税金のために余分な金がいるんだって。"
                },
                {
                    "ID": 46,
                    "DefaultText": "さて、そろそろ戻らないと。じゃあな、アンドレアス。"
                }
            ]
        },
        {
            "Name": "conversations/act1/act1_eva",

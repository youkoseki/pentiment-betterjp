        {
            "Name": "conversations/act2/act2_johan",
            "UObjectName": "act2_johan_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "アンドレアス、あんたと俺で、話さなきゃならんことがあるんだ。"
                },
                {
                    "ID": 4,
                    "DefaultText": "いいだろう。何の話だい？"
                },
                {
                    "ID": 5,
                    "DefaultText": "そうなのかい？"
                },
                {
                    "ID": 6,
                    "DefaultText": "どうして大修道院長に手を貸してるんだ？ あいつが俺らの家族に何をしてきたのか知ってるはずだろう？"
                },
                {
                    "ID": 7,
                    "DefaultText": "だって、あの人は無実だ！"
                },
                {
                    "ID": 10,
                    "DefaultText": "ペテロの抑えられない怒りのせいで、あの図書館が燃え上がるのは嫌なんだ！"
                },
                {
                    "ID": 11,
                    "DefaultText": "無実だと？ 信じられないな。"
                },
                {
                    "ID": 19,
                    "DefaultText": "本？ そのためなのか？"
                },
                {
                    "ID": 20,
                    "DefaultText": "一冊も読んだことがないよ。殺人者を守る価値があるなんて信じられない。"
                },
                {
                    "ID": 21,
                    "DefaultText": "俺はオットーみたいに頭は良くないが、自分がコケにされてるのに気づかないほど間抜けじゃない。"
                },
                {
                    "ID": 22,
                    "DefaultText": "アンドレアス、あんたは前にうちの食卓の客だったろう。一言くらい聞いてくれてもいいんじゃないか？"
                },
                {
                    "ID": 23,
                    "DefaultText": "そういう態度を取りたいのか？"
                },
                {
                    "ID": 24,
                    "DefaultText": "分かった、いいだろう。何について話したいんだ？"
                },
                {
                    "ID": 27,
                    "DefaultText": "<shake>とっとと失せろ、クソ野郎！</shake>"
                },
                {
                    "ID": 28,
                    "DefaultText": "言っただろ？ 彼は無実なんだ。"
                },
                {
                    "ID": 29,
                    "DefaultText": "大修道院を焼き払えば、状況が良くなると本当に思っているのか？"
                },
                {
                    "ID": 30,
                    "DefaultText": "大修道院長への怒りは理解できるが、修道士たちが死ぬべきだとは思えないよ。"
                },
                {
                    "ID": 31,
                    "DefaultText": "でも、俺が言ったとおり、あいつは何年もの間、俺たちを苦しめてきたんだ。"
                },
                {
                    "ID": 33,
                    "DefaultText": "蓄えなんざ雀の涙ほどだってのに、あいつは少しずつ全部を吸い上げてきた。今、あいつが食らっているのは皮と、骨と、誇りだと言ってもいい。"
                },
                {
                    "ID": 34,
                    "DefaultText": "農家の誇りを食らわれたら、搾り取られて何も残らないだろ。"
                },
                {
                    "ID": 35,
                    "DefaultText": "なら、アンドレアス、俺たちは何に値するってんだ？ 餓死か？"
                },
                {
                    "ID": 36,
                    "DefaultText": "アンドレアス、あんたが最後にひもじい思いをしたのはいつだ？"
                },
                {
                    "ID": 40,
                    "DefaultText": "ただな、大修道院長が俺たちのことを気にかけないって言うなら、あいつが気にかけているものを傷つけるしかないじゃないか。"
                },
                {
                    "ID": 44,
                    "DefaultText": "いいだろう。言うべきことは言った。あんたのやるべきことをやるがいい、マーラー。"
                },
                {
                    "ID": 46,
                    "DefaultText": "あんたのやるべきことをやるがいい、マーラー。"
                },
                {
                    "ID": 51,
                    "DefaultText": "ありがとう。君は元気だったかい？"
                },
                {
                    "ID": 54,
                    "DefaultText": "そうだったのか。君たちは元気だったかい？"
                },
                {
                    "ID": 56,
                    "DefaultText": "あんたが去った後、しばらくは上手く行ってたんだ。"
                },
                {
                    "ID": 58,
                    "DefaultText": "兄の土地を譲り受けることはできたかもしれないが、あんたも聞いたと思うが、マルティンが戻ってきやがったんだ。"
                },
                {
                    "ID": 61,
                    "DefaultText": "ケンパリン未亡人が剣にかけられて、大修道院長が俺たちにラニッヒの土地を耕させてくれたんだ。"
                },
                {
                    "ID": 62,
                    "DefaultText": "ケンパリン未亡人は土地を失って、大修道院長が俺たちにそこを耕させたんだ。"
                },
                {
                    "ID": 67,
                    "DefaultText": "うーん、まあ、私はただ通りがかっただけなんだ..."
                },
                {
                    "ID": 79,
                    "DefaultText": "何だって？ 本当にか？"
                },
                {
                    "ID": 80,
                    "DefaultText": "なぜそんなことをするんだ？"
                },
                {
                    "ID": 84,
                    "DefaultText": "マルティン...本当に？ なぜそう言い切れるんだ？"
                },
                {
                    "ID": 86,
                    "DefaultText": "え、そうなのか？"
                },
                {
                    "ID": 89,
                    "DefaultText": "そうさ。きっとそれが、あいつがオットーを殺した理由だろうよ。"
                },
                {
                    "ID": 91,
                    "DefaultText": "オットーが怪しまれていたからか？"
                },
                {
                    "ID": 92,
                    "DefaultText": "どうしてそう思うんだ？"
                },
                {
                    "ID": 93,
                    "DefaultText": "見たくないものは、みんなのためだと言い聞かせて、できる限り見て見ぬふりをするもんさ。"
                },
                {
                    "ID": 94,
                    "DefaultText": "エヴァのきれいな金髪のことだって、俺は何も言わないさ。"
                },
                {
                    "ID": 99,
                    "DefaultText": "つまり、彼が優秀すぎるから、偽者だと思っているのか？"
                },
                {
                    "ID": 100,
                    "DefaultText": "何か証拠があるのか？"
                },
                {
                    "ID": 101,
                    "DefaultText": "そうだ。俺たちはみんな、そう言い合ってきたんだ。"
                },
                {
                    "ID": 103,
                    "DefaultText": "フランツよりも、7 年前にここを去ったろくでなしよりも、もっと役に立つ人が必要だったってことさ。"
                },
                {
                    "ID": 106,
                    "DefaultText": "土地を広げなきゃならなかったんだ。兄と俺は断れなかった。"
                },
                {
                    "ID": 107,
                    "DefaultText": "アンドレアス、俺は自分を聖人だと思っちゃいない。だけどな、兄は正真正銘のろくでなしだった。"
                },
                {
                    "ID": 110,
                    "DefaultText": "だから、そうだ。あいつが偽者だと思うのは、昔の甥っ子が悪かったのと同じくらい、今のあいつが出来すぎてるからさ。"
                },
                {
                    "ID": 111,
                    "DefaultText": "それで、その土地は俺たち 2 人のものになったんだ。で、フランツの死後、一部がマルティンのものになった。"
                },
                {
                    "ID": 116,
                    "DefaultText": "ややこしいんだが、そうなると、あいつは俺の土地を他人の土地の向こう側に置くことになっちまうんだ。"
                },
                {
                    "ID": 117,
                    "DefaultText": "この契約は、俺たちが一緒に土地を保有しているからこそ成り立つのさ。"
                },
                {
                    "ID": 118,
                    "DefaultText": "マルティンが偽者だと知ったら、悪い奴らが何をするかは分かるだろ？"
                },
                {
                    "ID": 119,
                    "DefaultText": "マルティンが...本当は誰か分からないけど、オットーを殺したと本当に思っているのか？"
                },
                {
                    "ID": 122,
                    "DefaultText": "他人の妻と寝るだって？ よく自分のことを棚に上げて言えるな。"
                },
                {
                    "ID": 125,
                    "DefaultText": "口の利き方に気をつけろよ！"
                },
                {
                    "ID": 127,
                    "DefaultText": "いや、マルティンが賃貸地の売却を持ち出さなければ、問題はなかったんだがな。"
                }
            ]
        },

        {
            "Name": "conversations/act2/act2_ursula",
            "UObjectName": "act2_ursula_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 4,
                    "DefaultText": "こんにちは、ウルスラ。私のことは覚えているかい？"
                },
                {
                    "ID": 5,
                    "DefaultText": "うーん...ううん。覚えてるはずなの？"
                },
                {
                    "ID": 6,
                    "DefaultText": "私だよ、アンドレアスだ！ 私は君の家族の長年の友人だ。"
                },
                {
                    "ID": 8,
                    "DefaultText": "わからなくてもおかしくない。私はもう、君のご両親が泊めてくれた貧しい芸術家ではないからな。"
                },
                {
                    "ID": 9,
                    "DefaultText": "君のおじさんみたいなものだ。"
                },
                {
                    "ID": 10,
                    "DefaultText": "あぁ！ 芸術家の！ アンドレアス、だよね？"
                },
                {
                    "ID": 11,
                    "DefaultText": "失くさないように靴下と一緒にしまってあるの。"
                },
                {
                    "ID": 12,
                    "DefaultText": "ああ、芸術家の？ ちょっと覚えてるけど..."
                },
                {
                    "ID": 13,
                    "DefaultText": "それに絵を描いてくれたわ。まだその絵、持ってるの！"
                },
                {
                    "ID": 14,
                    "DefaultText": "あぁ、芸術家の。アンドレアス、だよね？"
                },
                {
                    "ID": 15,
                    "DefaultText": "お父さんとお母さんはよくあなたの話をしているわ。修行のために旅立ったのよね。"
                },
                {
                    "ID": 16,
                    "DefaultText": "そうか。"
                },
                {
                    "ID": 17,
                    "DefaultText": "[黙り続ける]"
                },
                {
                    "ID": 18,
                    "DefaultText": "私が小さい頃、あなたは世界中で作品を作るために旅に出たって言ってたわ。"
                },
                {
                    "ID": 21,
                    "DefaultText": "どんなだった？"
                },
                {
                    "ID": 22,
                    "DefaultText": "そうだな、クラクフにいる間、新しい印刷技術を学んで..."
                },
                {
                    "ID": 23,
                    "DefaultText": "そうだな、ロンドンにいる間、新しい肖像画の技術を学んで..."
                },
                {
                    "ID": 24,
                    "DefaultText": "そうだな、パリにいる間、新しい油絵の技術を学んで..."
                },
                {
                    "ID": 25,
                    "DefaultText": "そうだな、アラゴンにいる間、色を作る新しい技術を学んで..."
                },
                {
                    "ID": 26,
                    "DefaultText": "芸術のことじゃなくてさ、アンドレアス！ 旅の話！"
                },
                {
                    "ID": 27,
                    "DefaultText": "芸術のことじゃなくてさ、アンドレアス！ 旅の話！"
                },
                {
                    "ID": 28,
                    "DefaultText": "芸術のことじゃなくてさ、アンドレアス！ 旅の話！"
                },
                {
                    "ID": 29,
                    "DefaultText": "芸術のことじゃなくてさ、アンドレアス！ 旅の話！"
                },
                {
                    "ID": 35,
                    "DefaultText": "いつか見れるかもしれないぞ。"
                },
                {
                    "ID": 47,
                    "DefaultText": "アラゴンほど色々な人に会える場所はない。"
                },
                {
                    "ID": 50,
                    "DefaultText": "バルタスって？"
                },
                {
                    "ID": 51,
                    "DefaultText": "発明家みたい。お父さんは役立たずだと言ってるけど、私は面白い人だと思う。"
                },
                {
                    "ID": 58,
                    "DefaultText": "クラクフはここから遠く離れている。まずはニュルンベルクに行ってみるといい。"
                },
                {
                    "ID": 59,
                    "DefaultText": "もういいかい？"
                },
                {
                    "ID": 62,
                    "DefaultText": "じゃあね、アンドレアス！"
                },
                {
                    "ID": 64,
                    "DefaultText": "お父さんは、冬を乗り切ることができれば運がいいって言っているけど、大げさだと思うの。"
                },
                {
                    "ID": 65,
                    "DefaultText": "そこは近いの？"
                },
                {
                    "ID": 66,
                    "DefaultText": "あぁ、もっと近い。"
                },
                {
                    "ID": 67,
                    "DefaultText": "それなら、いつか見れるかも！"
                },
                {
                    "ID": 68,
                    "DefaultText": "まだまだよ！ あなたって面白いんだもん、アンドレアス。"
                },
                {
                    "ID": 69,
                    "DefaultText": "えぇ、本当？ 沈まないの？"
                },
                {
                    "ID": 71,
                    "DefaultText": "トマス神父が話してた奇跡、紅海が分裂した話みたい！"
                },
                {
                    "ID": 72,
                    "DefaultText": "そうかもしれないな。"
                },
                {
                    "ID": 73,
                    "DefaultText": "奇跡ではないさ、ウルスラ。人々が設計し、手で作り上げたんだ。"
                },
                {
                    "ID": 74,
                    "DefaultText": "<red>神</red>は人類に<red>神</red>の栄光を反映する構造を創造する能力を与えた。ロンドン橋もその一つだ。"
                },
                {
                    "ID": 75,
                    "DefaultText": "ふふっ！ 本当にトマス神父みたいなことを言うのね。"
                },
                {
                    "ID": 77,
                    "DefaultText": "それは大変そう。農家でよかった。"
                },
                {
                    "ID": 78,
                    "DefaultText": "お父さんは大学なんて時間の無駄だって言ってた。手に職をつけるべきだって。"

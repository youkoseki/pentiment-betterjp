        {
            "Name": "conversations/act2/act2_til",
            "UObjectName": "act2_til_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "こんにちは、マーラー先生。"
                },
                {
                    "ID": 2,
                    "DefaultText": "こんばんは、ティル。楽しんでるかい？"
                },
                {
                    "ID": 5,
                    "DefaultText": "夏至の言葉のもとはローマ人の言葉だとご存じですか？"
                },
                {
                    "ID": 14,
                    "DefaultText": "しかし、それを補うために踊り、跳び、歌をうたう！ 喜びと陽気さ。"
                },
                {
                    "ID": 16,
                    "DefaultText": "オットーは自ら危険を招きました、たしかにそのとおり。大修道院の教令に反するなど..."
                },
                {
                    "ID": 18,
                    "DefaultText": "しかし、本当に衰退を遠ざけることができるのか？"
                },
                {
                    "ID": 20,
                    "DefaultText": "<red>彼</red>が成長し、私は衰退しなければならないと、洗礼者は言っていました。過去の時代とこれからの新しい時代の間の関門です。"
                },
                {
                    "ID": 21,
                    "DefaultText": "太陽は毎年消えていきますが、戻ってきます。少なくとも、悪い状態のままで終わりはしないでしょう？"
                },
                {
                    "ID": 26,
                    "DefaultText": "教会がそれを異端として非難しないようにある程度、神聖でなければならない。"
                },
                {
                    "ID": 28,
                    "DefaultText": "その通りですね、マーラー先生。"
                },
                {
                    "ID": 31,
                    "DefaultText": "それに、彼らは常に危険な感覚を楽しんでいますよね？"
                },
                {
                    "ID": 32,
                    "DefaultText": "はぁ。"
                },
                {
                    "ID": 33,
                    "DefaultText": "それで、私たちは何を笑っているんだ？"
                },
                {
                    "ID": 34,
                    "DefaultText": "社会の愚か者、のようなものでしょうか。人々が立ち向かう悪徳。特に私たち農民よりも...重要な人物たちを。"
                },
                {
                    "ID": 35,
                    "DefaultText": "社会の愚か者、のようなものでしょうか。人々がふける悪徳。特に私たち農民よりも...重要な人物たちを。"
                },
                {
                    "ID": 37,
                    "DefaultText": "マーラー先生、天国にいる<red>主</red>を除いて、永遠に続くものはありませんよ。"
                },
                {
                    "ID": 44,
                    "DefaultText": "町にいる他の誰かに似ていますね。今となってはもっと分別があってもいいはずなのに。"
                },
                {
                    "ID": 45,
                    "DefaultText": "彼らを責めることはできないでしょう。興奮で頭にカッと血が昇ってしまうんです。活力が...湧いてきます。"
                },
                {
                    "ID": 46,
                    "DefaultText": "オットーのことを言ってるなら、そうかもな。大修道院に対してそういう行動は...面倒になるかもしれん。"
                },
                {
                    "ID": 56,
                    "DefaultText": "でもこの話はお祝いの前夜にするべき話ではない、マーラー先生。"
                },
                {
                    "ID": 58,
                    "DefaultText": "今夜は楽しんで、マーラー先生。後でまた。"
                },
                {
                    "ID": 59,
                    "DefaultText": "あったよ、マーラー先生。"
                },
                {
                    "ID": 63,
                    "DefaultText": "こんにちは、マーラー先生。"
                },
                {
                    "ID": 69,
                    "DefaultText": "それほどでもありませんよ、マーラー先生。主にことわざといくつかの言葉。それ故に...夏至。"
                },
                {
                    "ID": 70,
                    "DefaultText": "それほど多くはしりません。ことわざといくつかの言葉。それ故に...夏至。"
                },
                {
                    "ID": 71,
                    "DefaultText": "夏至...太陽が空で静止するんです。この時期に見られる現象です。"
                },
                {
                    "ID": 77,
                    "DefaultText": "でも...全部は理解できなかった。ラテン語だったんでね。"
                },
                {
                    "ID": 82,
                    "DefaultText": "でも彼らは本当に同じ人々だったのか...あるいはどこからかの遊牧民だったのかね。"
                },
                {
                    "ID": 87,
                    "DefaultText": "彼はこの場所をラティウムと呼び、それを土壁の小屋の集まりと表現し、人々は敵対的および好戦的で、狩猟と戦いにのみ興味があったらしい。"
                },
                {
                    "ID": 89,
                    "DefaultText": "ああ、著名な哲学者であり歴史家ですね。彼はギリシャ人として生を受けたんです。彼の地理誌はお読みになったと推察しますが？"
                },
                {
                    "ID": 90,
                    "DefaultText": "いえ、彼の著作を読む機会には恵まれていないと思います。"
                }
            ]
        },

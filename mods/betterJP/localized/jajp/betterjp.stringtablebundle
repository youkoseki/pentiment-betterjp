                {
                    "ID": 80,
                    "DefaultText": "尋ねてみましょう！ でも、誰がそんなことを知ってるんです？"
                }
            ]
        },
        {
            "Name": "conversations/act2/act2_mob_night",
            "UObjectName": "act2_mob_night_BaseGame_jajp",
            "Entries": [
                {

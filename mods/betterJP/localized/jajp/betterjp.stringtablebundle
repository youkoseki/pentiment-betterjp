        {
            "Name": "conversations/act1/act1_clara",
            "UObjectName": "act1_clara_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 4,
                    "DefaultText": "あら！ もう午後なの？ すっかり夢中になっていたわ。"
                },
                {
                    "ID": 6,
                    "DefaultText": "羊毛はもう全部洗ったから、後は子羊たちが生まれてくる前に紡がなきゃならない糸紡ぎの山があるわ。ああ、どうやって時間を作ればいいのかしら？"
                },
                {
                    "ID": 7,
                    "DefaultText": "誰が紡ぐんだ？ 君が？"
                },
                {
                    "ID": 8,
                    "DefaultText": "大変そうだ。誰かに助けてもらえるのかい？"
                },
                {
                    "ID": 9,
                    "DefaultText": "まあ、まさか。女一人で背負うには大変すぎるわ。女たちはみんなで手を貸し合うのよ。"
                },
                {
                    "ID": 10,
                    "DefaultText": "手が多ければ仕事は簡単になるということかい？"
                },
                {
                    "ID": 11,
                    "DefaultText": "赤ちゃんのウルスラも？"
                },
                {
                    "ID": 12,
                    "DefaultText": "楽しいのかい？ 君はたくさんの羊を飼っているし、とても大変そうだ。"
                },
                {
                    "ID": 13,
                    "DefaultText": "ええ、遊べるように少し羊毛は渡しているけれど、あの子はまだ小さすぎるわ。"
                },
                {
                    "ID": 14,
                    "DefaultText": "それも、そう長くはないでしょうけど。母は、私がまだ柔らかい靴を履いていた頃から、糸紡ぎを教えてくれたのよ。"
                },
                {
                    "ID": 15,
                    "DefaultText": "全員が労働を分担するなら、利益分配はどうやって決めるんだ？"
                },
                {
                    "ID": 17,
                    "DefaultText": "私たちが紡ぐ羊毛が、アルプスの冬のあいだ、町の皆を暖かく包むんですもの。"
                },
                {
                    "ID": 18,
                    "DefaultText": "一生懸命働いていると時間があっという間に過ぎるのは、<red>神</red>に感謝ね。でも、一日があと数時間あってもいいのに、とは思うわ。"
                },
                {
                    "ID": 20,
                    "DefaultText": "先週、出産期に入る前に雌羊たちの毛を刈ったの。彼らの鳴き声を覚えているはずよ。"
                },
                {
                    "ID": 21,
                    "DefaultText": "しかも、羊毛に取りかかるのはそれからなのよ。ああ、本当に、あの羊毛の山ったら..."
                },
                {
                    "ID": 22,
                    "DefaultText": "羊毛？"
                },
                {
                    "ID": 23,
                    "DefaultText": "手伝いはいらないかい？ 紡績のことは何も知らないけど、ぜひ学びたいんだ。"
                },
                {
                    "ID": 24,
                    "DefaultText": "やさしいのね、アンドレアス。でも、それは...ふさわしいかしら。田舎の作法というものがあるでしょう？"
                },
                {
                    "ID": 26,
                    "DefaultText": "ええ、時には必要以上に！ タッシングの女性のほとんどが手を貸してくれるから、すぐに終わるわ。"
                },
                {
                    "ID": 32,
                    "DefaultText": "男は見に行っても？"
                },
                {
                    "ID": 35,
                    "DefaultText": "ああ、アンドレアス、ぜひ来て！"
                },
                {
                    "ID": 39,
                    "DefaultText": "それは嬉しい！"
                },
                {
                    "ID": 42,
                    "DefaultText": "そろそろ仕事に戻るけれど、会えてよかったわ、アンドレアス。どうか気をつけてね。"
                },
                {
                    "ID": 48,
                    "DefaultText": "糸紡ぎの集いで会いましょう、アンドレアス。"
                },
                {
                    "ID": 49,
                    "DefaultText": "こんにちは、アンドレアス。夕食のご予定がなければ、うちで一緒にいかがかしら？"
                },
                {
                    "ID": 50,
                    "DefaultText": "こんにちは、アンドレアス。夕食のご予定がなければ、ご一緒にいかがかしら？"
                },
                {
                    "ID": 56,
                    "DefaultText": "ええ、もちろん。お元気で、アンドレアス。"
                },
                {
                    "ID": 57,
                    "DefaultText": "洗濯でなければ、料理、修繕、片付け。仕事に終わりはないわ！"
                },
                {
                    "ID": 58,
                    "DefaultText": "羊たちはもう子を産んだかい？"
                },
                {
                    "ID": 59,
                    "DefaultText": "そうなの、もうすぐなのよ！ あなたが気づくとは思わなかったわ。"
                },
                {
                    "ID": 60,
                    "DefaultText": "忘れられると思うかい？ まだ聞こえてくるようだよ。"
                },
                {
                    "ID": 63,
                    "DefaultText": "ああ、そうだった。ミサか。トマス神父から、出席するようにとしつこく言われているんだ。"
                },
                {
                    "ID": 64,
                    "DefaultText": "「隣人を自分のように愛しなさい」。ええ、トマス神父はその説教がお好きでしたものね。"
                },
                {
                    "ID": 65,
                    "DefaultText": "あなたがここに来てから、あの説教を何度聞かされたの？"
                },
                {
                    "ID": 66,
                    "DefaultText": "<red>神よ</red>、もう 3 回か 4 回にはなるだろうね。"
                },
                {
                    "ID": 70,
                    "DefaultText": "彼女も...？"
                },
                {
                    "ID": 72,
                    "DefaultText": "もちろんよ。あの子は家族みんなのことを心配しているの。そして、あなたが私たちと一緒にいる限り、あなたも家族なのよ。"
                },
                {
                    "ID": 77,
                    "DefaultText": "はは。神父様は、頭の中で歌が鳴りやまない男みたいなものだね。ただ、その歌が<red>神の言葉</red>だというだけで。"
                },
                {
                    "ID": 79,
                    "DefaultText": "エヴァも...来るのかい？"
                },
                {
                    "ID": 82,
                    "DefaultText": "ただの悪気のない質問だったんだ！"
                },
                {
                    "ID": 85,
                    "DefaultText": "エヴァの将来はここタッシングにあるの。彼女はここにいるべきよ。この家族も、町も...私たちには彼女が必要なの。"
                },
                {
                    "ID": 89,
                    "DefaultText": "ご心配なく。私は彼女をどこかへ連れて行くつもりなんてありませんでしたから。"
                },
                {
                    "ID": 90,
                    "DefaultText": "[ウィンク] もちろんだ、ゲルトネリン夫人。"
                },
                {
                    "ID": 92,
                    "DefaultText": "さて、私たちが糸を紡ぐところを見に来てくださるかしら？"
                },
                {
                    "ID": 96,
                    "DefaultText": "さあ、どうかしら。様子を見ましょう。"
                },
                {
                    "ID": 122,
                    "DefaultText": "おはよう、クララ。相変わらず忙しいのかい？"
                },
                {
                    "ID": 123,
                    "DefaultText": "こんにちは、クララ。相変わらず忙しいのかい？"
                },
                {
                    "ID": 124,
                    "DefaultText": "こんばんは、クララ。相変わらず忙しいのかい？"
                },
                {
                    "ID": 126,
                    "DefaultText": "大助祭が今朝共有地を通ったわ。そろそろあなたを呼ぶのかしら？"
                },
                {
                    "ID": 130,
                    "DefaultText": "ペテロが壁のことであまり気に病んでいないといいのだけれど。あの人の心臓が心配だわ..."
                },
                {
                    "ID": 137,
                    "DefaultText": "アンドレアス、大修道院までの道のりが気持ちのいいものになりますように。"
                },
                {
                    "ID": 138,
                    "DefaultText": "畑に雨が必要なのはわかってるけど、今日の午後は森の聖堂を訪れたかったのよ！"
                },
                {
                    "ID": 139,
                    "DefaultText": "かわいそうなウルスラ、嵐で彼女は寝れてないわ。彼女が寝ないと、私も休めないのよ！"
                },
                {
                    "ID": 142,
                    "DefaultText": "こんにちは、クララ。少し話せるかい？"
                },
                {
                    "ID": 143,
                    "DefaultText": "もちろん、アンドレアス。どうしたの？"
                },
                {
                    "ID": 144,
                    "DefaultText": "大修道院への税金が遅れていると言ったね。正確にはどれくらい不足しているんだ？"
                },
                {
                    "ID": 147,
                    "DefaultText": "ああ、アンドレアス...あなたは私たちのお客様で、店子でもあるのよ。それに、一人で払うには多すぎる額だわ。"
                },
                {
                    "ID": 152,
                    "DefaultText": "いくらなんだ？"
                },
                {
                    "ID": 153,
                    "DefaultText": "そんなに多いはずないだろう？ 君の農場はヨハンの農場よりも小さいじゃないか。"
                },
                {
                    "ID": 155,
                    "DefaultText": "まあ、大修道院が税を上げたのよ...だから<whisper>今、私たちは大修道院に金貨 2 枚を納めなければならないの</whisper>。"
                },
                {
                    "ID": 158,
                    "DefaultText": "ああ、なるほど。まだ耕す土地が残っているうちは、ペテロさんは施しを求めるには誇りが高すぎるんだね。"
                },
                {
                    "ID": 159,
                    "DefaultText": "ペテロの矜恃が許さないのよ、まだ耕す土地が残ってるうちはね。"
                },
                {
                    "ID": 162,
                    "DefaultText": "早く払えてうれしいよ、クララ。君たちにはよくしてもらったし、私は君たち家族より、お金がなくてもやっていけるからね。"
                },
                {
                    "ID": 163,
                    "DefaultText": "アンドレアス、<red>神</red>のご加護があらんことを。ペテロには言わないで、いい？ 私がこのことを話したって知ったら彼はきっと怒るわ。"
                },
                {
                    "ID": 164,
                    "DefaultText": "あなたがそう言うなら。"
                },
                {
                    "ID": 165,
                    "DefaultText": "ええ。"
                },
                {
                    "ID": 167,
                    "DefaultText": "アンドレアス、私たちの重荷をあなたに負わせてしまってごめんなさい。キリスト教徒らしからぬ行いだったわ。"
                },
                {
                    "ID": 169,
                    "DefaultText": "ええと、わかったよ。"
                },
                {
                    "ID": 170,
                    "DefaultText": "ありがとう、アンドレアス"
                },
                {
                    "ID": 171,
                    "DefaultText": "私は仕事に戻るわね。"
                },
                {
                    "ID": 180,
                    "DefaultText": "アンドレアス！ これはあなたの家賃よりもずっと多いわ。こんなには受け取れないわ。"
                },
                {
                    "ID": 183,
                    "DefaultText": "何かしら？"
                },
                {
                    "ID": 187,
                    "DefaultText": "ああ。君が大修道院に税金を払えるようにね。"
                },
                {
                    "ID": 188,
                    "DefaultText": "いや、私のじゃないな。エヴァかビッグ・ヨルグが残していったのかな？"
                },
                {
                    "ID": 189,
                    "DefaultText": "受け取ってくれ。大修道院長に返済するには十分だろう？"
                },
                {
                    "ID": 190,
                    "DefaultText": "お願いだ、クララ。私にできるのはそれくらいなんだ。君とペテロはとてもよくしてくれた。"
                },
                {
                    "ID": 194,
                    "DefaultText": "<red>主</red>の御技はさまざま。彼は君にこの奇跡を与えたに違いない。"
                },
                {
                    "ID": 195,
                    "DefaultText": "いや、誰も。でもそれはもらっておくべきだと思うよ。<green>一体誰が</green>それを残したとしても、彼らはわかっていてやったはずだ。"
                },
                {
                    "ID": 196,
                    "DefaultText": "そうだけど、アンドレアス！ どうやってそんなにたくさんのお金を手に入れたの？ 自分の分は足りているの？"
                },
                {
                    "ID": 197,
                    "DefaultText": "私のことは心配しないで、クララ。大丈夫だよ。"
                },
                {
                    "ID": 200,
                    "DefaultText": "でもアンドレアス、どうやってそんなにたくさんのお金を見つけたの？ 自分の分は足りているの？"
                },
                {
                    "ID": 202,
                    "DefaultText": "「控えめに蒔く者は控えめに刈り取り、豊かに種をまく者は豊かに刈り取るであろう」"
                },
                {
                    "ID": 203,
                    "DefaultText": "ああ、アンドレアス、ありがとう...でも、どうやってそんなにたくさんのお金を手に入れたの？ 自分の分は足りているの？"

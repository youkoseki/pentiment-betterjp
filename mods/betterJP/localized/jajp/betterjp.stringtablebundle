            "Name": "conversations/act1/act1_brigita",
            "UObjectName": "act1_brigita_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "何かあったのかい？"
                },
                {
                    "ID": 4,
                    "DefaultText": "暗い日だよ。ロスフォーゲル男爵が大修道院で殺害されたんだ、聞いたかい？"
                },
                {
                    "ID": 8,
                    "DefaultText": "なんてこと！ 誰に？ まさか修道士じゃ...！"
                },
                {
                    "ID": 11,
                    "DefaultText": "刃を持った人物でなければ、他に誰がいるっていうの？"
                },
                {
                    "ID": 18,
                    "DefaultText": "でもあなたはそうじゃないのかい？"
                },
                {
                    "ID": 19,
                    "DefaultText": "私は彼が今朝、大修道院から逃げるのを見たんだ...ロスフォーゲル男爵が殺されたと知る、ちょうど直前にね。"
                },
                {
                    "ID": 20,
                    "DefaultText": "それはお気の毒に。彼がどこに行ったのか知っているかい？"
                },
                {
                    "ID": 21,
                    "DefaultText": "<red>神よ！</red>"
                },
                {
                    "ID": 30,
                    "DefaultText": "フランツに耐えるためか。"
                },
                {
                    "ID": 33,
                    "DefaultText": "彼のことは一言も口にしなかったでしょう。その沈黙が、何よりも物語っていたわ。"
                },
                {
                    "ID": 34,
                    "DefaultText": "フランツは難しい男で、マルティンにはとても厳しいわ。それが彼を...<red>気難しく</red>させたの。"
                },
                {
                    "ID": 35,
                    "DefaultText": "殺人を犯せるほど「気難しく」？"
                },
                {
                    "ID": 36,
                    "DefaultText": "いいえ！ いいえ。マルティンの上にはいつも暗雲が垂れ込めているけど、雨が降るのは彼の上にだけよ。"
                },
                {
                    "ID": 38,
                    "DefaultText": "マルティンが男爵を殺したと思うか？"
                },
                {
                    "ID": 42,
                    "DefaultText": "認めざるを得ないだろう、怪しく見えるのは確かだ。"
                },
                {
                    "ID": 43,
                    "DefaultText": "何のことを言ってるの？"
                },
                {
                    "ID": 44,
                    "DefaultText": "[嘘] たいしたことじゃない。暇つぶしの質問だよ。迷惑をかけて申し訳なかった。"
                },
                {
                    "ID": 47,
                    "DefaultText": "<whisper>それに、独身の男の人と話していたら、ね。</whisper>"
                },
                {
                    "ID": 48,
                    "DefaultText": "もちろんだ。<red>神</red>の御心なら、マルティンはじきに帰ってくるさ。"
                },
                {
                    "ID": 53,
                    "DefaultText": "私は彼が今朝、大修道院から逃げるのを見たんだ...ロスフォーゲル男爵が殺されたと知る、ちょうど直前にね。"
                },
                {
                    "ID": 54,
                    "DefaultText": "<frantic>いや！</frantic> そんなこと言わないで！"
                },
                {
                    "ID": 57,
                    "DefaultText": "たとえば、指輪二つと金貨少々。彼の殺害の前に男爵の部屋から取られていた。"
                },
                {
                    "ID": 63,
                    "DefaultText": "[疑わしげに眉をひそめる] あなたがそう言うなら。"
                },
                {
                    "ID": 65,
                    "DefaultText": "男爵を殺した犯人が誰なのかを、知りたいだけなんだ。"
                },
                {
                    "ID": 68,
                    "DefaultText": "わかったわ。話を聞いてくれてありがとう。"
                },
                {
                    "ID": 69,
                    "DefaultText": "<frantic>何で彼がそんなことをするのよ？！</frantic>"
                },
                {
                    "ID": 70,
                    "DefaultText": "彼は...彼は男爵のことなんて一切知らないのに！"
                },
                {
                    "ID": 73,
                    "DefaultText": "あなたは何がなんでもマルティンを悪者にしたいのね。彼を生贄にしようとしてるんだわ！"
                },
                {
                    "ID": 74,
                    "DefaultText": "私には、<red>神</red>と...夫を信じることしかできないわ。"
                },
                {
                    "ID": 77,
                    "DefaultText": "[何も言わない]"
                },
                {
                    "ID": 78,
                    "DefaultText": "泥棒は<shake>殺人者</shake>じゃないわ！"
                },
                {
                    "ID": 79,
                    "DefaultText": "<red>神よ</red>。彼がそんなに愚かだったはずがないわ...！"
                },
                {
                    "ID": 80,
                    "DefaultText": "好きなように思えばいいわ。あなたの考えは変えられないのね。"
                },
                {
                    "ID": 81,
                    "DefaultText": "彼が指輪を取るのを見たの？ なぜそう言えるの？"
                },
                {
                    "ID": 83,
                    "DefaultText": "それは関係あるのか？"
                },
                {
                    "ID": 84,
                    "DefaultText": "あなたは私の夫を<shake>殺人者</shake>だと言ってるのよ！"
                },
                {
                    "ID": 85,
                    "DefaultText": "これ以上は話さないほうがよさそうだ。すまない。"
                },
                {
                    "ID": 87,
                    "DefaultText": "彼はマルティンが指輪を取るのを見たの？ 金貨も？"
                },
                {
                    "ID": 88,
                    "DefaultText": "彼を見たって<red>主</red>の前でも誓えるの？"
                },
                {
                    "ID": 89,
                    "DefaultText": "彼は前日にマルティンが大修道院の宿坊の周りに潜んでいるのを見た。合理的な帰結だ。"
                },
                {
                    "ID": 90,
                    "DefaultText": "それなら彼もわかってないし...<shake>あなたも！</shake>"
                },
                {
                    "ID": 91,
                    "DefaultText": "私は彼が木曜日の朝...ロスフォーゲル男爵が殺された直後に大修道院から逃げるのを見た。"
                },
                {
                    "ID": 92,
                    "DefaultText": "ロスフォーゲル男爵は大修道院で殺された、聞いたかい？"
                },
                {
                    "ID": 93,
                    "DefaultText": "私は彼が木曜日の朝...ロスフォーゲル男爵が殺された直後に大修道院から逃げるのを見た。"
                },
                {
                    "ID": 94,
                    "DefaultText": "彼は今朝、気分が悪いと言っていたの。それで、また何か企んでいるんだとすぐに分かったのよ。"
                },
                {
                    "ID": 96,
                    "DefaultText": "先日、私も宿坊の近くでマルティンを見かけた。彼は奇妙な行動を取っていた。"
                },
                {
                    "ID": 97,
                    "DefaultText": "あなたは彼が宿坊の近くに立っているのを見た、それで...それだけで彼が有罪だというの？"
                }
            ]
        },

                }
            ]
        },
        {
            "Name": "conversations/act3/act3_franziska",
            "UObjectName": "act3_franziska_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "<red>神</red>のご加護がありますように、マグダレネ。"
                },
                {
                    "ID": 2,
                    "DefaultText": "<red>神</red>のご加護を。マグダレネ。あなたと話したいと思っていたのですよ。"
                },
                {
                    "ID": 3,
                    "DefaultText": "<red>神</red>のご加護がありますように、マグダレネ。"
                },
                {
                    "ID": 4,
                    "DefaultText": "修道女になることについて、もう少し考えてみましたか？"
                },
                {
                    "ID": 5,
                    "DefaultText": "私は父の看病で頭が一杯で、それどころではないのです、院長さま。"
                },
                {
                    "ID": 7,
                    "DefaultText": "そのことでしつこく迫らないでください、マザー。何度も断ったはずです。"
                },
                {
                    "ID": 9,
                    "DefaultText": "あなたの心の冷たさは、相変わらずのようですね。"
                },
                {
                    "ID": 10,
                    "DefaultText": "なるほど。危険な道を歩こうとしているのですね、マグダレネ。<red>御霊</red>の導きを。"
                },
                {
                    "ID": 14,
                    "DefaultText": "そのことで気が変わったら、いつでも歓迎しますよ。"
                },
                {
                    "ID": 15,
                    "DefaultText": "そのことで悩んでいるのなら、いつでも相談してくださいね。"
                },
                {
                    "ID": 16,
                    "DefaultText": "少し、お時間よろしいですか？"
                },
                {
                    "ID": 17,
                    "DefaultText": "もちろんですとも。どうしたのですか？"
                },
                {
                    "ID": 18,
                    "DefaultText": "あなたは、お父さんが襲われた後、庁舎の壁画に取り組むようになったと聞きました。"
                },
                {
                    "ID": 19,
                    "DefaultText": "そうです。それが何か？"
                },
                {
                    "ID": 23,
                    "DefaultText": "ええと、何ですって？"
                },
                {
                    "ID": 24,
                    "DefaultText": "そのような職業は、女性ではなく、男性に向いているのです。<xg>パウロ</xg>が書いているように、<red>神</red>は女性に商売ではなく、家庭で働くよう求めています。"
                },
                {
                    "ID": 29,
                    "DefaultText": "待ってください。私が<blue>悩ませている</blue>なんて誰が言ったんですか？ それに、どこでそんなことを聞いたんですか？ あなたたちは、ここに閉じこもっているんじゃなかったんですか？"
                },
                {
                    "ID": 31,
                    "DefaultText": "でも、聖女ヒルデガルトは、女性だけど音楽や本を書きました。女であることを理由に断念しなかった。同じ女の私がなぜあきらめなくてはいけないのでしょう？"
                },
                {
                    "ID": 33,
                    "DefaultText": "はい、町の歴史を描くのは楽しみです。"
                },
                {
                    "ID": 36,
                    "DefaultText": "父から店の切り盛りを教わって、印刷が好きになったんです。印刷業者として働くことの何が悪いんですか？"
                },
                {
                    "ID": 37,
                    "DefaultText": "あなたは「マザー」かもしれませんが、私の母ではありませんよ。"
                },
                {
                    "ID": 40,
                    "DefaultText": "で、口うるさくて気難しい年寄りになれば、主に近づけるんですか？ 本当に？"
                },
                {
                    "ID": 41,
                    "DefaultText": "では、あなたのためにイチジクの葉を身につけていない人を描いておきますね、院長さま。"
                },
                {
                    "ID": 43,
                    "DefaultText": "...残念ですね。それでも、あなたには期待していますよ、マグダレネ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "聖女ヒルデガルトは、<red>神</red>に選ばれ、長年の試練と病気を乗り越えました。"
                },
                {
                    "ID": 47,
                    "DefaultText": "むしろ、権威や良識をいっさい無視するあなたを見ていると、修道院での生活こそあなたのためになると思わされますね。"
                },
                {
                    "ID": 53,
                    "DefaultText": "マグダレネ、あなたも彼女のように犠牲を払うつもりですか？"
                },
                {
                    "ID": 56,
                    "DefaultText": "<red>主</red>を試してはなりませんよ、お嬢さん。傲慢は破滅に先立つ、と言うでしょう。"
                },
                {
                    "ID": 57,
                    "DefaultText": "これ以上、何を望むというのですか？"
                },
                {
                    "ID": 59,
                    "DefaultText": "では私には、あなたが<red>御霊</red>に手を導かれ、<red>神</red>を賛美するよう祈るばかりです。"
                },
                {
                    "ID": 63,
                    "DefaultText": "良識を持たないでいると痛い目にあいますよ！"
                },
                {
                    "ID": 64,
                    "DefaultText": "私の提案をよく考えてみてください、マグダレネ。"
                },
                {
                    "ID": 65,
                    "DefaultText": "でもせっかくだから教えてあげましょう。トマス神父が、修道院に入ることはあなたのためになるかもしれないとおっしゃっていました。"
                },
                {
                    "ID": 66,
                    "DefaultText": "心配してくださってありがとうございます。でも、大丈夫です。"
                },
                {
                    "ID": 67,
                    "DefaultText": "トマス神父が？ このことは、神父様本人と話をした方がいいかもしれませんね。"
                },
                {
                    "ID": 68,
                    "DefaultText": "二人ともやめてください！ 噂話はキリスト教徒らしくないですよ、マザー・フランツィスカ。"
                },
                {
                    "ID": 70,
                    "DefaultText": "タッシングの人々は、あなたのことを大切に思っているのです、マグダレネ。それを忘れないでください。"
                },
                {
                    "ID": 71,
                    "DefaultText": "あの方があなたが求めている導きを与えてくださるよう、祈っています、マグダレネ。"
                },
                {
                    "ID": 74,
                    "DefaultText": "<blue>一部</blue>の人たち？"
                },
                {
                    "ID": 75,
                    "DefaultText": "まさか、その中にあなたも含まれていたりしませんよね？"
                },
                {
                    "ID": 76,
                    "DefaultText": "うーん。"
                },
                {
                    "ID": 78,
                    "DefaultText": "ええ、マグダレネ、私も含めてです。"
                },
                {
                    "ID": 79,
                    "DefaultText": "この件に関しては、評議会の見方は狭いと言わざるを得ません。"
                },
                {
                    "ID": 82,
                    "DefaultText": "どういうことですか、院長さま。"
                },
                {
                    "ID": 85,
                    "DefaultText": "マグダレネ・ドラッカリン！"
                },
                {
                    "ID": 93,
                    "DefaultText": "マグダレネ・ドラッカリン！"
                },
                {
                    "ID": 94,
                    "DefaultText": "ですが、修道院に入りたくなったら、いつでも歓迎しますよ。"
                },
                {
                    "ID": 95,
                    "DefaultText": "マザー・フランツィスカ、私はクララ会に加わるつもりはありません。この話はこれで終わりにしてください。"
                },
                {
                    "ID": 96,
                    "DefaultText": "...わかりました。"
                },
                {
                    "ID": 97,
                    "DefaultText": "その気まぐれな性格を心配しているからこそ、あなたをここに招いたのです。きっとあなたのためになると思います。"
                },
                {
                    "ID": 103,
                    "DefaultText": "トマス神父でも構いませんよ。"
                },
                {
                    "ID": 104,
                    "DefaultText": "ありがとうございます。"
                },
                {
                    "ID": 105,
                    "DefaultText": "<red>神</red>のご加護がありますように、マグダレネ。"
                }
            ]
        },

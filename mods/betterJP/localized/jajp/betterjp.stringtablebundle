                {
                    "ID": 12,
                    "DefaultText": "冬の森はいつもむき出しね。この時期には誰も来ないわ。"
                }
            ]
        },
        {
            "Name": "conversations/act3/examinables/act3_examinables_rathausexterior",
            "UObjectName": "act3_examinables_rathausexterior_BaseGame_jajp",
            "Entries": [
                {

            "UObjectName": "act1_murder_chapterhouse_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "お願いします、神父様、フロリアン修道士はどちらに？ 急いで呼んでください。"

                }
            ]
        },
        {
            "Name": "conversations/act2/act2_kat",
            "UObjectName": "act2_kat_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "アンドレアス？ アンドレアス・マーラー？"
                },
                {
                    "ID": 2,
                    "DefaultText": "会えて嬉しいわ、アンドレアス。"
                },
                {
                    "ID": 3,
                    "DefaultText": "やあ、キャット。"
                },
                {
                    "ID": 4,
                    "DefaultText": "マルティンなんだが、私の記憶にある彼とは違ってるように思えたんだ。何か変わったと思うかい？"
                },
                {
                    "ID": 7,
                    "DefaultText": "あはは！ そうかしらねぇ。"
                },
                {
                    "ID": 8,
                    "DefaultText": "ああ、そうね。あなたがタッシングを去った時、あの人はまだ戻ってきてなかったから。"
                },
                {
                    "ID": 10,
                    "DefaultText": "ああ、でも、あなたがタッシングを去った時、あの人はまだ戻ってきてなかったのよね？"
                },
                {
                    "ID": 18,
                    "DefaultText": "彼を変えたきっかけていうのはその旅かい？ それとも時間かい？"
                },
                {
                    "ID": 19,
                    "DefaultText": "彼は今も町で問題を起こしているのかい？"
                },
                {
                    "ID": 20,
                    "DefaultText": "人間の心の真実を知るのは神様だけだわ。だけど、旅の間に出会った試練が、故郷に対する思いをいい方向に変えたんじゃないかって思っているの。"
                },
                {
                    "ID": 21,
                    "DefaultText": "いやいや！ そんなことはないわ。あの人は町でも心強い存在になっているの。それに、ブリギータにもよくしてくれているのよ。"
                },
                {
                    "ID": 22,
                    "DefaultText": "あら、アンドレアス。"
                },
                {
                    "ID": 24,
                    "DefaultText": "やあ、キャット。"
                },
                {
                    "ID": 25,
                    "DefaultText": "あら、見てよこれ！ あなた、タッシングに<blue>戻ってきた</blue>のね！"
                },
                {
                    "ID": 26,
                    "DefaultText": "それに見てみて！ 見るからに順調そうじゃない。ところで、その方はどなた？"
                },
                {
                    "ID": 28,
                    "DefaultText": "キャット、私の見習いのキャスパーを紹介するよ。"
                },
                {
                    "ID": 35,
                    "DefaultText": "元気だったかい、キャット？ 上手くやってそうだね。"
                },
                {
                    "ID": 37,
                    "DefaultText": "わかるわ、前にあなたがこの町にいた時、あの人失踪してたからね。"
                },
                {
                    "ID": 39,
                    "DefaultText": "フランツが数年前の冬に亡くなってしまってね。それからヴォルフも。ブリギータと私は危うく農場を失いかけたの。頭もおかしくなりそうだったのを覚えているわ。"
                },
                {
                    "ID": 49,
                    "DefaultText": "ヨハンはね、ブリギータと私のために管理するからって買いたがっていたのだけど、税金があんな状態だから..."
                },
                {
                    "ID": 50,
                    "DefaultText": "どんな女にも、オッティリア・ケンパリンのような終わりは嫌だわ。特に私自身にはね。"
                },
                {
                    "ID": 54,
                    "DefaultText": "今はタッシングにとって難しい時期かもしれないけど、神様は本当に、私たちの祈りに応えてくださるのよ。"
                },
                {
                    "ID": 59,
                    "DefaultText": "ありがとう、アンドレアス。こんな悲惨な時期ではあるけれど、また会えて本当に嬉しいわ。"
                },
                {
                    "ID": 73,
                    "DefaultText": "だけど今朝、彼がオットーと口論しているのを見かけたんだ。理由なんか知っているかい？"
                },
                {
                    "ID": 74,
                    "DefaultText": "だけど先日、彼とオットーが口論していたんだ。その理由を知っているかい？"
                },
                {
                    "ID": 76,
                    "DefaultText": "そうだったの？ ごめんなさいね、アンドレアス。私、そのことは何も知らなくて。"
                },
                {
                    "ID": 77,
                    "DefaultText": "マルティンは、大修道院長の税金に反対するオットーを支持しているの。ケンカする理由なんてないはずよ。"
                },
                {
                    "ID": 80,
                    "DefaultText": "キャット、戻ってきた男はマルティンじゃない。彼の名前はヨブスト・フェルバーだ。"
                },
                {
                    "ID": 85,
                    "DefaultText": "あるわけないわ！ あの二人はここ数年、仲のいい友人だったのよ。まるで兄弟のようにね。"
                },
                {
                    "ID": 86,
                    "DefaultText": "マルティンが変わったことは知っているけれど、<frantic>別人</frantic>になったって言うの？ そんなバカな！"
                },
                {
                    "ID": 91,
                    "DefaultText": "<red>主</red>がマルティンを光に導いてくださったことを感謝しなくちゃいけないのよ！"
                },
                {
                    "ID": 99,
                    "DefaultText": "...その通りです。"
                },
                {
                    "ID": 100,
                    "DefaultText": "キャット...ああ、気にしないで。"
                },
                {
                    "ID": 107,
                    "DefaultText": "あの人、もう何年も盗みもしていないし、出奔もしていないわ。本当に、主は信心深い者にお恵みを与えてくださるのよ。"
                },
                {
                    "ID": 108,
                    "DefaultText": "<red>主</red>がマルティンを光に導いてくださったことを感謝しなくちゃいけないのよ！"
                },
                {
                    "ID": 117,
                    "DefaultText": "キャット！ マーラー先生がどうかしたのかい？"
                },
                {
                    "ID": 118,
                    "DefaultText": "あはっ！ まったく同じことを聞かせてもらうわ。見違えるくらい立派になっちゃって！"
                },
                {
                    "ID": 119,
                    "DefaultText": "それで、この人は誰なの？"
                },
                {
                    "ID": 120,
                    "DefaultText": "アンドレアス、何がきっかけでタッシングに戻ってきたの？"
                },
                {
                    "ID": 123,
                    "DefaultText": "主の祝福は、時に不思議な形で与えられることもあるものね。だけど、祝福はどれも同じ祝福なのよ。"
                },
                {
                    "ID": 125,
                    "DefaultText": "実のところ、トマス神父が世話してくださらなかったら、私は試練でつぶれていたんじゃないかと思うの。"
                },
                {
                    "ID": 126,
                    "DefaultText": "あの方は助言をくださったの...フランツが死んだ時の、辛い気持ちについて。"
                },
                {
                    "ID": 129,
                    "DefaultText": "神様の御許にいる今、あの人の苦悩や恐怖が消え去っていることを祈っているわ。"
                },
                {
                    "ID": 130,
                    "DefaultText": "<whisper>私、本当にそう思っているのかしら？</whisper>"
                },
                {
                    "ID": 131,
                    "DefaultText": "あの人が私たちを貧困から救ってくれたのよ。"
                },
                {
                    "ID": 135,
                    "DefaultText": "たしかに、あの人が信仰を持っていないとは言えなかったわね。どんな困難があっても、決して揺らぐことはなかったわ。あの人が主の御許で安らいでいることを祈っているの。"
                },
                {
                    "ID": 136,
                    "DefaultText": "それに、マルティンが戻ってきてくれた今、農場はもう危険にさらされていないし、ブリギータと私も、早くもっと子供ができることを願って生きているのよ。"
                },
                {
                    "ID": 139,
                    "DefaultText": "他に何と言えばいいのかわからないわ。ごめんなさいね。"
                },
                {
                    "ID": 140,
                    "DefaultText": "何も言うことなんてないでしょ？"
                },
                {
                    "ID": 141,
                    "DefaultText": "あの子はいい子だったわ。可愛くて、小さないい子だったの。あの子が死んで、星の光も陰ったような気がしたものよ。"
                },
                {
                    "ID": 142,
                    "DefaultText": "だけど、それも何年も前のことなの。そのことにはこだわらないで、ブリギータのために強くなって、あの子が今神様の御許にいるって考えることで、慰めを得ようと思っているのよ。"
                },
                {
                    "ID": 144,
                    "DefaultText": "あの方とヨハンの家族がいなかったら、私たちは何をしていたかわからないわ。"
                },
                {
                    "ID": 145,
                    "DefaultText": "あの頃は暗い日々だったの、アンドレアス。でも、それはもう終わったのよ。"
                },
                {
                    "ID": 148,
                    "DefaultText": "そうね、そんなところかしら。"
                },
                {
                    "ID": 149,
                    "DefaultText": "あの人のことをそんな風に言うのは罪だとわかっているけれど、真実でもあるのよね。"
                },
                {
                    "ID": 150,
                    "DefaultText": "あの人は酷い男だったわ。戻ってきてほしいとは思わないの。"
                },
                {
                    "ID": 153,
                    "DefaultText": "あはっ！ 確かにそうかもね。"
                }
            ]
        },
        {
            "Name": "conversations/act2/act2_martin",
            "UObjectName": "act2_martin_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "そう言ってくれるとは意外だな。あの時の別れ際の言葉は、あまり優しくなかったはずだが。"
                },
                {
                    "ID": 4,
                    "DefaultText": "こちらこそ。"
                },
                {
                    "ID": 5,
                    "DefaultText": "そうだったか？ ずいぶん前のことだから覚えてないよ。"
                },
                {
                    "ID": 6,
                    "DefaultText": "クソでも食ってろ、と言われたんだよ。"
                },
                {
                    "ID": 8,
                    "DefaultText": "おお<red>神</red>よ...そりゃひどい。俺はほんとクソガキだったんだな、ハハ。"
                },
                {
                    "ID": 9,
                    "DefaultText": "まあ、あの頃は嫌な奴で悪かったな。"
                },
                {
                    "ID": 11,
                    "DefaultText": "気にすることはないさ。もう昔の話だ。"
                },
                {
                    "ID": 12,
                    "DefaultText": "7 年は、若い男には長い時間だ。特に、あの頃の俺みたいな境遇の男にはな。"
                },
                {
                    "ID": 13,
                    "DefaultText": "一体何があったんだ？"
                },
                {
                    "ID": 14,
                    "DefaultText": "俺が男爵の物を盗んだのは知ってるだろう？ 結局、たいして遠くまでは行けなかったがな。"
                },
                {
                    "ID": 16,
                    "DefaultText": "幸い、持っていた小銭は盗られなかった。その金でさらに 1 か月半、バイエルンを回れたよ。"
                },
                {
                    "ID": 18,
                    "DefaultText": "山賊だったのか？"
                },
                {
                    "ID": 19,
                    "DefaultText": "殺されずに済んでよかったな！"
                },
                {
                    "ID": 25,
                    "DefaultText": "...だが実際は、ジェノヴァの聖ゲオルギウス銀行の金を守ってる兵士たちだった、と。"
                },
                {
                    "ID": 29,
                    "DefaultText": "俺は傷を負って、荒野にひとり取り残された。"
                },
                {
                    "ID": 34,
                    "DefaultText": "現代の放蕩息子、といったところだな。"
                },
                {
                    "ID": 35,
                    "DefaultText": "そうしてくれてよかったよ。みんなのためにもな。"
                },
                {
                    "ID": 37,
                    "DefaultText": "責任なんて、持ち上げられすぎだよ。"
                },
                {
                    "ID": 43,
                    "DefaultText": "責任を負うのは、俺の性に合ってるよ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "ハッ！ アンドレアス。"
                },
                {
                    "ID": 47,
                    "DefaultText": "乱闘があってから、気分はどうだ？"
                },
                {
                    "ID": 49,
                    "DefaultText": "ははっ。あの傭兵には、そっちもだいぶやられたようだな。"
                },
                {
                    "ID": 51,
                    "DefaultText": "ああ、私も忘れないだろうな。"
                },
                {
                    "ID": 54,
                    "DefaultText": "本当か？ <green>マルティン</green>は食事を吐いたりしてないだろう。"
                },
                {
                    "ID": 60,
                    "DefaultText": "吐いたのか...ヘヘ。俺も危ないとこだったよ。"
                },
                {
                    "ID": 65,
                    "DefaultText": "まあ、君は大して損をしなかったんだから、馬鹿を見たのは俺のほうってことか。"
                },
                {
                    "ID": 67,
                    "DefaultText": "最近はどうしてた？ 調子はよさそうだな。"
                },
                {
                    "ID": 76,
                    "DefaultText": "...それについては話したくない。"
                },
                {
                    "ID": 78,
                    "DefaultText": "ハッ！ こっちはウルムに行っただけで旅の達人扱いなのに。"
                },
                {
                    "ID": 79,
                    "DefaultText": "それは何よりだな、アンドレアス。子供はまだか？"
                },
                {
                    "ID": 83,
                    "DefaultText": "<red>神</red>もご存じだろうが、俺も、帰ってきたときは過去についてあまり話したくなかったんだ。"
                },
                {
                    "ID": 84,
                    "DefaultText": "とはいえ、田舎者にしては、ずいぶん冒険をしてきたほうだと思うがな。"
                },
                {
                    "ID": 87,
                    "DefaultText": "もう一度やり直す機会があるだけでも、運がいいと思ってるよ。"
                },
                {
                    "ID": 93,
                    "DefaultText": "町の連中は、大修道院長が公爵を巻き込んだら、得るものが少なくて失うものが多いからな。"
                },
                {
                    "ID": 98,
                    "DefaultText": "ヴェルナー・シュトルツが言っていた。君は傷痕を、それも大きなものを失くした、とね。"
                },
                {
                    "ID": 99,
                    "DefaultText": "ヨブスト・フェルバーとは誰だ？"
                },
                {
                    "ID": 100,
                    "DefaultText": "牧草地で気づいたんだが、君はくしゃみをしていなかった。"
                },
                {
                    "ID": 102,
                    "DefaultText": "何だって！？ 傷なら子供の頃に負ったが、もう治ったんだ。"
                },
                {
                    "ID": 104,
                    "DefaultText": "君は子供の頃、あの牧草地が大嫌いだったな。くしゃみが止まらなかったから。"
                },
                {
                    "ID": 106,
                    "DefaultText": "自然を苦手とする人間は、そう簡単に治るものではない。"
                },
                {
                    "ID": 113,
                    "DefaultText": "私は酒場の喧嘩だとは言っていないぞ。"
                },
                {
                    "ID": 115,
                    "DefaultText": "ああ。さっき乱闘したばかりだから、混乱したんだ。"
                },
                {
                    "ID": 116,
                    "DefaultText": "何を言わせたいんだ？ 治ったって言ったぞ。"
                },
                {
                    "ID": 122,
                    "DefaultText": "最初はオットー。今日は私だ。次は誰が君の秘密に気づくんだろうな？"
                },
                {
                    "ID": 125,
                    "DefaultText": "彼女が？ なぜそんなことを言うのか分からないが。"
                },
                {
                    "ID": 126,
                    "DefaultText": "あんたがイカれたことを言い出すからだ！ どうしたっていうんだ、アンドレアス？"
                },
                {
                    "ID": 127,
                    "DefaultText": "もういい。こんな話を、ここで黙って聞いている義理はない。"
                },
                {
                    "ID": 128,
                    "DefaultText": "邪魔をするな。もう一度、目に青あざを作ってやろうか。"
                },
                {
                    "ID": 132,
                    "DefaultText": "分かったよ！ もううんざりだ。"
                },
                {
                    "ID": 133,
                    "DefaultText": "俺はマルティンじゃない。これで満足か？"
                },
                {
                    "ID": 134,
                    "DefaultText": "逃げ帰って町中に触れ回るのか？ 俺の人生を台無しにしたいのか？ ブリギータの人生もか？ 俺の母親の―"
                },
                {
                    "ID": 138,
                    "DefaultText": "何だと！？ 俺がオットーを殺したと思ってるのか？"
                },
                {
                    "ID": 139,
                    "DefaultText": "違うぞ。なにっ、どうしてだ？ 俺が殺したとでも思ってるのか？"
                },
                {
                    "ID": 141,
                    "DefaultText": "それは本当だ。でも、なぜ俺があいつを殺さなきゃならないんだ？ 俺はあいつの言うとおりにしたんだ。"
                },
                {
                    "ID": 142,
                    "DefaultText": "彼に何度も問い詰められるのが怖くなったのかもしれない。"
                },
                {
                    "ID": 143,
                    "DefaultText": "君は前にも人を殺している。今さら、それほど難しくないのかもしれないな。"
                },
                {
                    "ID": 144,
                    "DefaultText": "オットーが誰かに話してしまうのも時間の問題だった。エヴァか？ トマス神父か？"
                },
                {
                    "ID": 145,
                    "DefaultText": "あれは事故だったんだ！ 言い争いになって手が付けられなくなったんだ。"
                },
                {
                    "ID": 146,
                    "DefaultText": "オットーは話したりしない。あいつはいい男だ。"
                },
                {
                    "ID": 148,
                    "DefaultText": "いや、話すはずがない。俺たちは取引をしたんだ。"
                },
                {
                    "ID": 152,
                    "DefaultText": "その話は、よく考えてみるとしよう。"
                },
                {
                    "ID": 154,
                    "DefaultText": "分かったな？"
                },
                {
                    "ID": 155,
                    "DefaultText": "よし。"
                },
                {
                    "ID": 158,
                    "DefaultText": "ああ。ではまた、マルティン。"
                },
                {
                    "ID": 159,
                    "DefaultText": "アンドレアス、神のご加護を。"
                },
                {
                    "ID": 161,
                    "DefaultText": "路上で死んだんだ。銀行の兵士に殺されてな。"
                },
                {
                    "ID": 163,
                    "DefaultText": "あいつは死人の出た家から盗みを働いて、次は自分の番にならないようにと聖ロクスに祈っていたよ。"
                },
                {
                    "ID": 166,
                    "DefaultText": "行く先々で兄弟と間違われた。あいつが死んだあとも...別に悪いことだとは思わなかった。"
                },
                {
                    "ID": 167,
                    "DefaultText": "ヨブスト・フェルバーは世間じゃ死んだも同然だった。俺はミュールドルフにはもう戻れなかったんだ。"
                },
                {
                    "ID": 168,
                    "DefaultText": "マルティン・バウアーの人生は、ここにまだ残っていた。俺のものじゃなかったとしてもな。"
                },
                {
                    "ID": 173,
                    "DefaultText": "そうか？ そんなに信じがたいことなのか？ それであんたはどうするつもりなんだ？"
                },
                {
                    "ID": 174,
                    "DefaultText": "あいつはこの家族に穴を空けたまま、振り返りもしなかったさ。"
                },
                {
                    "ID": 181,
                    "DefaultText": "あんたも知っての通り、俺はマルティンじゃない。いいさ、話すべき相手に話せばいい。だが、俺はオットーを殺していない。"
                },
                {
                    "ID": 188,
                    "DefaultText": "何か手伝おうか？"
                },
                {
                    "ID": 189,
                    "DefaultText": "喧嘩のことは知っている。あの男を殺すつもりはなかったんだろう。ああいうことは、時に起きてしまうものだ。"
                },
                {
                    "ID": 193,
                    "DefaultText": "こちらこそ。君の...あの行いは大作に描かなかったが、気にしないでほしい。"
                },
                {
                    "ID": 195,
                    "DefaultText": "俺の...？ ああ、もう大昔の話だ。水に流そうじゃないか。"
                },
                {
                    "ID": 197,
                    "DefaultText": "幸い、君だって載せてほしくなかったはずだ。"
                },
                {
                    "ID": 198,
                    "DefaultText": "構わないさ、アンドレアス。気にしないでくれ。どのみち、あんたの寛大さを受けるに値しなかったんだ。"
                },
                {
                    "ID": 199,
                    "DefaultText": "ハハ、ならお互い様だな。寛大に扱ってもらう値打ちなんて、どのみちなかったのさ。"
                }
            ]
        },
        {
            "Name": "conversations/act2/act2_karl",
            "UObjectName": "act2_karl_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 5,
                    "DefaultText": "それで、焚き火はどうだった？ 今年はいい感じにできたんだ。デカくて頑丈に。"
                },
                {
                    "ID": 10,
                    "DefaultText": "アントン、親方画家のアンドレアス・マーラーを覚えているか？"
                },
                {
                    "ID": 12,
                    "DefaultText": "坊主、行儀よくしろ。"
                },
                {
                    "ID": 13,
                    "DefaultText": "うっ。こんにちは、マーラー先生。お元気ですか？"
                },
                {
                    "ID": 15,
                    "DefaultText": "悪くないよ。ニュルンベルクに戻ってからは、あまり楽しい時期じゃなかったんだ。"
                },
                {
                    "ID": 18,
                    "DefaultText": "あっ！ 父さん、やめろってば！？"
                },
                {
                    "ID": 19,
                    "DefaultText": "ハハハ！ 母さんと同じで、お前を怒らせるのは簡単だな。"
                },
                {
                    "ID": 20,
                    "DefaultText": "ヘレナは元気かい？ 焚き火には来ていないのかい？"
                },
                {
                    "ID": 23,
                    "DefaultText": "いつもってわけじゃないがな、ハハ！ 言っちまえば、少しばかりやんちゃだが、頭も心根もいいのさ、ふてぶてしい顔で隠そうとしてるけどな。"
                },
                {
                    "ID": 30,
                    "DefaultText": "そんなんじゃねえよ、アンドレアス。先駆者たる聖ヨハネは夜に通りを歩いて、ドアにリースのかかった家を祝福するんだ。"
                },
                {
                    "ID": 34,
                    "DefaultText": "ポーランドでは、若い恋人同士が一緒に森に入ってシダを探すんだ。婚約の儀式みたいなものなんだよ。"
                },
                {
                    "ID": 35,
                    "DefaultText": "心配はいらないよ、アントン。悪魔や悪霊を追い払うセイヨウオトギリの花輪なら、君はいつだって手に入れられるんだから。"
                },
                {
                    "ID": 39,
                    "DefaultText": "そうだな、わかったか、アントン？ 今夜、地上を歩く霊たちに目を光らせておくんだぞ。"
                },
                {
                    "ID": 42,

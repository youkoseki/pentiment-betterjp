        {
            "Name": "conversations/act1/act1_steinauer_meal",
            "UObjectName": "act1_steinauer_meal_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 3,
                    "DefaultText": "疲れているようだな、アグネス。エルゼに遅くまで付き合わされたのか？"
                },
                {
                    "ID": 4,
                    "DefaultText": "ああ、気にしないで。あの子は助けを必要としているし、私も喜んでそうしているのよ。"
                },
                {
                    "ID": 5,
                    "DefaultText": "エルゼに何があったんだ？"
                },
                {
                    "ID": 6,
                    "DefaultText": "誰かがこの町の女たちの面倒を見なければならないのに、ヴェルナーは全然気にかけてくれないのよ。"
                },
                {
                    "ID": 7,
                    "DefaultText": "医師には頼らないのかい？"
                },
                {
                    "ID": 8,
                    "DefaultText": "あの人はひどいのよ。会ったことがないの？"
                },
                {
                    "ID": 9,
                    "DefaultText": "自分がいい大学に行ったからって、なんでもわかると思ってる高慢な人よ！"
                },
                {
                    "ID": 10,
                    "DefaultText": "あなたなら、あの人よりずっとまともな町医者になれるでしょうね！ 少なくとも、町人たちのことを気にかけてくれるし、私の話もちゃんと聞いてくれるもの！"
                },
                {
                    "ID": 11,
                    "DefaultText": "もちろん、あなたのことを言っているんじゃないわ、アンドレアス。あなたは自分の学歴をひけらかしたりしないもの。"
                },
                {
                    "ID": 37,
                    "DefaultText": "タッシングで結婚生活に苦しんでいるのは、あの子だけじゃないのよ。"
                },
                {
                    "ID": 41,
                    "DefaultText": "ところで、アンドレアスに大修道院での仕事のことを話さないの？ 建物の中で何か変なものを見つけたって言っていたじゃない。"
                },
                {
                    "ID": 46,
                    "DefaultText": "変ってどんな風に？"
                },
                {
                    "ID": 49,
                    "DefaultText": "聖母の浮き彫りにぶつかったら、ドアが開いたんだ！ めちゃくちゃだよ。"
                },
                {
                    "ID": 50,
                    "DefaultText": "それこそが修道女たちの図書館への行き方なんだ！"
                },
                {
                    "ID": 52,
                    "DefaultText": "それはどこに繋がっていたんだ？"
                },
                {
                    "ID": 54,
                    "DefaultText": "その話、私は聞いてないわよ！"
                },
                {
                    "ID": 58,
                    "DefaultText": "なんかおかしかったろ？ 階段のスペースがないのに、修道女たちはどうやってかあそこに登ってるんだ。"
                },
                {
                    "ID": 101,
                    "DefaultText": "シスター・イルミナータを死ぬほど驚かせたでしょうね。"
                },
                {
                    "ID": 102,
                    "DefaultText": "きっと大丈夫だよ。たまには見知らぬ男にドキッとするのはいいものだろう？"
                },
                {
                    "ID": 105,
                    "DefaultText": "アンドレアス！ あなたも人が悪いのね。うふふ。"
                },
                {
                    "ID": 111,
                    "DefaultText": "私のブリギータでさえ、悩みを抱えているのよ。"
                },
                {
                    "ID": 114,
                    "DefaultText": "あの二人の結婚を許すべきじゃなかったよ。マルティン・バウエリンにあの子はもったいなかった。"
                },
                {
                    "ID": 116,
                    "DefaultText": "あの子はあの人を愛しているのよ、ラッキー。それに、いずれ結婚しなければならなかったわ。私たちに一体何ができたと言うの？"
                },
                {
                    "ID": 118,
                    "DefaultText": "私も同じものを発見したんだ！ 実に興味深い建築上の特徴じゃないか。"
                },
                {
                    "ID": 121,
                    "DefaultText": "[嘘] はあ...なんてことだ..."
                },
                {
                    "ID": 124,
                    "DefaultText": "数週間前、子どもを失ったのよ。"
                },
                {
                    "ID": 125,
                    "DefaultText": "お腹の赤ちゃんが動き出したと大喜びしていたのだけど、すぐにまた出血が始まってしまってね。"
                },
                {
                    "ID": 126,
                    "DefaultText": "あの子にとっては辛いことだったわ。でも前にも乗り越えてきたし、これからも乗り越えていくはずよ。"
                },
                {
                    "ID": 127,
                    "DefaultText": "彼女は<red>キリスト</red>への愛と、夫への愛を強く持っているのよ。"
                },
                {
                    "ID": 128,
                    "DefaultText": "レンハルトにはもったいないけれど、あの子はあの人を深く愛しているのよ。"
                },
                {
                    "ID": 129,
                    "DefaultText": "それはどうして？"
                },
                {
                    "ID": 131,
                    "DefaultText": "夫の言葉は聞かなくていいのよ。この人はまっすぐで高貴すぎるくらいなんだから。"
                },
                {
                    "ID": 132,
                    "DefaultText": "あんたが噂好きだとは思ってもみなかったよ、アンドレアス。"
                },
                {
                    "ID": 133,
                    "DefaultText": "町のことが気になっているんだ。そんなにひどい状況なのか？"
                },
                {
                    "ID": 134,
                    "DefaultText": "[肩をすくめる]"
                },
                {
                    "ID": 135,
                    "DefaultText": "噂を広めるのはいい行いじゃないわ。"
                },
                {
                    "ID": 139,
                    "DefaultText": "粉屋は、農民にも奥さんにも優しくないのよ。"
                },
                {
                    "ID": 142,
                    "DefaultText": "何が楽しくてそんなことを？"
                },
                {
                    "ID": 143,
                    "DefaultText": "そうしなかったらどうなるんだ？ タッシングの粉屋は私には何もできないよ。"
                },
                {
                    "ID": 145,
                    "DefaultText": "あんたにはできないかもしれないが、あいつはゲルトナーを好きにできる。"
                },
                {
                    "ID": 146,
                    "DefaultText": "あいつらはあんたがここにいる間、養い、匿ってくれたんだ。同じ立場だったら、厄介事を起こしたくないな。"
                },
                {
                    "ID": 148,
                    "DefaultText": "楽しみを求めるより先に、あいつのゲルトナーに対する権力がどんなもんか考えてみてほしいね。"
                },
                {
                    "ID": 149,
                    "DefaultText": "誰が問題を起こすと？ それも全部思い込みじゃないか。"
                },
                {
                    "ID": 152,
                    "DefaultText": "私たちがエルゼにしてあげられるのは、<red>キリスト</red>が教えてくださったように、隣人として世話をすることくらいだわ。"
                },
                {
                    "ID": 153,
                    "DefaultText": "マルティン・バウアーの妻の？ 彼女があなた方の娘だとは知らなかったな。"
                },
                {
                    "ID": 154,
                    "DefaultText": "ブリギータ・バウエリン...彼女はあなた方の一人娘なのか？"
                },
                {
                    "ID": 157,
                    "DefaultText": "<red>神</red>よ、彼らの魂に安らぎを。"
                },
                {
                    "ID": 158,
                    "DefaultText": "レンハルトにも同じことを伝えようとしたのだけど、私はただの村の助産師でしょう。私の意見なんて、あの人みたいな男には大した価値がないようでね。"
                },
                {
                    "ID": 159,
                    "DefaultText": "あまり気にしなくていいのよ、アンドレアス。あの子にはパウロという息子がいるのが救いだわ。本当にいい子で、母親が大好きなのよ。"
                },
                {

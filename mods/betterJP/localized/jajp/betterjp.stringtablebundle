        {
            "Name": "conversations/act1/act1_intro_memorypalace",
            "UObjectName": "act1_intro_memorypalace_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 1,
                    "DefaultText": "そして大修道院長はこう言ったよ、「アンドレアス...」"
                },
                {
                    "ID": 2,
                    "DefaultText": "「図書館のシスターたちの気を散らさないでもらいたい」"
                },
                {
                    "ID": 3,
                    "DefaultText": "「4 月末までにこの注文を仕上げてもらいたい」"
                },
                {
                    "ID": 4,
                    "DefaultText": "「ピエロ修道士との会話は、必要最低限にとどめてくれ」"
                },
                {
                    "ID": 6,
                    "DefaultText": "へへ。また悪魔の仕事に精を出してるのか？"
                },
                {
                    "ID": 7,
                    "DefaultText": "焚きつけてはいけませんわ。"
                },
                {
                    "ID": 8,
                    "DefaultText": "仕事に打ち込めば、肉体の悦びにも勝る心の悦びが得られるものじゃよ。"
                },
                {
                    "ID": 9,
                    "DefaultText": "それは、あなたが予想していたよりずっと早いのではありませんか？"
                },
                {
                    "ID": 10,
                    "DefaultText": "ああ。5 月の半ばまでだと言われていたんだ。"
                },
                {
                    "ID": 11,
                    "DefaultText": "でも、ピエロ修道士はあなたにとって、知恵と励ましの源ではありませんか？"
                },
                {
                    "ID": 12,
                    "DefaultText": "そうなんだが、観想を旨とするキリスト教の生活の戒律は、修道士が無益なおしゃべりをすることを許さないんだ。"
                },
                {
                    "ID": 13,
                    "DefaultText": "<red>なんてこった</red>、揃いも揃って間抜けばかりだな。あと数か月の辛抱で済むんだ、ありがたく思えよ、アンドレアス。"
                },
                {
                    "ID": 14,
                    "DefaultText": "お前がもっと刺激的な情人たちと過ごすか、俺が<blue>ソクラテス流</blue>の生き方を身につけるか、どっちかだな。へへ。"
                },
                {
                    "ID": 15,
                    "DefaultText": "クソ野郎が！ あいつはこの先、お前に一文も上乗せしやしねえんだろう？ お前の汗の値打ちなんざ、これっぽっちも分かっちゃいねえ。"
                },
                {
                    "ID": 16,
                    "DefaultText": "労働の実りは、金銭ではなく、個人的な満足と己の向上で測るべきものじゃ。"
                },
                {
                    "ID": 17,
                    "DefaultText": "だが、満足だけじゃ食卓に飯は並ばねえだろう？ へへ。"
                },
                {
                    "ID": 18,
                    "DefaultText": "大修道院長には、何と返事をしたのだ、アンドレアス？"
                },
                {
                    "ID": 21,
                    "DefaultText": "大修道院長には、何と返事をしたのだ、アンドレアス？"
                },
                {
                    "ID": 22,
                    "DefaultText": "大修道院長には、何と返事をしたのだ、アンドレアス？"
                },
                {
                    "ID": 23,
                    "DefaultText": "「<red>神</red>が私をこんなに男前にお創りになったのは、私のせいではありません」と言ってやりました。"
                },
                {
                    "ID": 24,
                    "DefaultText": "謝って、もっと気をつけますと伝えました。"
                },
                {
                    "ID": 25,
                    "DefaultText": "無視いたしました。あのような言い草は、返事をする値打ちもございませんので。"
                },
                {
                    "ID": 26,
                    "DefaultText": "「できあがるときにはできあがります。5 月の半ばまでのいつかには」と言ってやりました。"
                },
                {
                    "ID": 27,
                    "DefaultText": "4 月末までに終えられるよう、最善を尽くしますと伝えました。"
                },
                {
                    "ID": 28,
                    "DefaultText": "肩をすくめて、そのまま仕事を続けました。"
                },
                {
                    "ID": 29,
                    "DefaultText": "謝って、今後は余計な会話を控えますと伝えました。"
                },
                {
                    "ID": 30,
                    "DefaultText": "戒律は彼のためのもので、私のためのものではないと答えました。私は芸術家であって、修道士ではありませんので。"
                },
                {
                    "ID": 31,
                    "DefaultText": "ただうなずいて、仕事を続けました。"
                },
                {
                    "ID": 33,
                    "DefaultText": "あなたという人は、どうしようもありませんわね。"
                },
                {
                    "ID": 34,
                    "DefaultText": "それはそうかもしれませんけれど、そのせいであなたは、あの方の不興を買ってしまったのですよ。"
                },
                {
                    "ID": 35,
                    "DefaultText": "己の務めと己自身に心を配るには、大いなる強さが要るものじゃ。"
                },
                {
                    "ID": 36,
                    "DefaultText": "とりわけ、かわいい修道女たちがそばにいる時にはな。"
                },
                {
                    "ID": 37,
                    "DefaultText": "なんでも下世話に取らなければ気が済みませんの？"
                },
                {
                    "ID": 38,
                    "DefaultText": "ああ...そうだが？"
                },
                {
                    "ID": 39,
                    "DefaultText": "それがどうしたってんだ？ 大修道院の注文を仕上げさせるにゃ、ゲルノット神父にはアンドレアスが要るんだぜ。"
                },
                {
                    "ID": 40,
                    "DefaultText": "規律と注意深さがあれば、耐え抜けるじゃろう。"
                },
                {
                    "ID": 41,
                    "DefaultText": "そういう言葉が聞きたかったんだ！ で、あいつに何ができる？ 5 月までに誰か他の奴を見つけて、お前の仕事を仕上げさせるってのか？"
                },
                {
                    "ID": 42,
                    "DefaultText": "その場の衝突を避ける手ではありますが、いずれまた同じことが持ち上がると、あなたも分かっているでしょう。"
                },
                {
                    "ID": 43,
                    "DefaultText": "会話も有益じゃろうが、お前さん自身の仕事からも学ぶことは山ほどあるぞ。"
                },
                {
                    "ID": 44,
                    "DefaultText": "ありがてえこった、<red>キリスト</red>様々だぜ、ははは！"
                },
                {
                    "ID": 45,
                    "DefaultText": "それに、大修道院長は大抵の日、あなたを見に来さえしないのですから、言い争うほどのことではありませんわ。"
                },
                {
                    "ID": 46,
                    "DefaultText": "悲しいかな、このキリスト教の信仰は、わしの時代ほど欲望に寛容ではないようじゃな。"
                },
                {
                    "ID": 47,
                    "DefaultText": "そうなのか？"
                },
                {
                    "ID": 48,
                    "DefaultText": "おそらく、お前さんへの憧れが、彼女たちの内に、美への感受性を育てることになるじゃろうて。"
                },
                {
                    "ID": 49,
                    "DefaultText": "そうともよ。今度、大修道院長にそう言ってやれよ、アンドレアス。へへ。"
                },
                {
                    "ID": 50,
                    "DefaultText": "仕事に打ち込むのは立派なことじゃが、シスターたちの気持ちのことで、大修道院長がお前さんを責めるのは筋違いじゃ。"
                },
                {
                    "ID": 51,
                    "DefaultText": "その通りだ。アンドレアスは大修道院長に雇われた身であって、この修道院の誓いを立てた修道士ではない。"
                },
                {
                    "ID": 52,
                    "DefaultText": "ただ、大修道院長の理不尽な期待に応えようとして、ご自分を追い詰めなければよいのですけれど。"
                },
                {
                    "ID": 53,
                    "DefaultText": "まったくだ、その姉さんの言う通りさ。あの馬鹿な大修道院長のために、蝋燭を芯まで燃やし尽くして何になる？"
                },
                {
                    "ID": 54,
                    "DefaultText": "どうでもいいだろ？ 大した問題じゃねえ。大修道院長は文句を垂れ続けるが、そのうち仕事は片付くさ。"
                },
                {
                    "ID": 55,
                    "DefaultText": "その通りですわ。大修道院長を敵に回すのは賢明ではないかもしれませんが、あの方にはあなたの仕事が必要なのですもの。"
                },
                {
                    "ID": 56,
                    "DefaultText": "それに、仕事をやり遂げること自体が徳というものじゃ。大修道院長がどう思おうと関わりない。"
                },
                {
                    "ID": 57,
                    "DefaultText": "大修道院長が怒ろうとも、そなたは耐えねばならぬ。まもなく、大修道院長の仕事も、そなたの大作も仕上がるであろう。"
                },
                {
                    "ID": 58,
                    "DefaultText": "そしてそなたはニュルンベルクへ戻る。そこでは、結婚と、親方としての新たな暮らしが、そなたを待っているのだ。"
                },
                {
                    "ID": 59,
                    "DefaultText": "ええ、会ったこともない方との結婚が、ですわね。とても理想的とは言えませんわ。"
                },
                {
                    "ID": 60,
                    "DefaultText": "ははあ、<red>なんてこった</red>、そりゃ絶対に結婚すべきだぜ。せめて、相手は器量よしなんだろうな？"
                },
                {
                    "ID": 61,
                    "DefaultText": "兄は手紙でそう書いていたけど、ただ私を励まそうとしただけかもしれない。"
                },
                {
                    "ID": 62,
                    "DefaultText": "送られてきた小さな肖像画は愛らしかったよ。でも、画家というのはお世辞を言うものだからね。"
                },
                {
                    "ID": 63,
                    "DefaultText": "さあ、どうだろう。とにかく、そのためにやっているわけじゃないんだ。"
                },
                {
                    "ID": 64,
                    "DefaultText": "でも、ピエロ修道士は、アンドレアスが自分の仕事を理解する手助けをしてくださっていますわ。あの方の経験は、若い芸術家にとってこのうえなく貴重です。"
                },
                {
                    "ID": 65,
                    "DefaultText": "彼の天職は<red>神</red>に仕えることじゃ。お前さんの天職は、己の仕事と、それがもたらす光明なのじゃよ。"
                },
                {
                    "ID": 66,
                    "DefaultText": "そうだな、フェレンツ小修道院長だって、大概のクソ野郎だがな。"
                },
                {
                    "ID": 67,
                    "DefaultText": "それがいやなら、あとは哲学者になるしかあるまい。"
                },
                {
                    "ID": 68,
                    "DefaultText": "夜も更けてきた。時の車輪は誰のためにも止まらぬのだ、アンドレアス。残念だが、そなたはここを去らねばならぬ。"
                },
                {
                    "ID": 69,
                    "DefaultText": "ああ、そうですね、陛下。"
                },
                {
                    "ID": 70,
                    "DefaultText": "また近いうちに訪ねてきてくれるか？"
                },
                {
                    "ID": 71,
                    "DefaultText": "そうできればと思いますが、私の力ではどうにもなりません、陛下。"
                },
                {
                    "ID": 72,
                    "DefaultText": "さあ、分かりません、陛下。"
                },
                {
                    "ID": 73,
                    "DefaultText": "その、いつもこの場所を夢に見られるわけではありませんので、陛下。"
                },
                {
                    "ID": 74,
                    "DefaultText": "多くのことがそうだ。摂理を信じるがよい。"
                },
                {
                    "ID": 75,
                    "DefaultText": "そなたの無事と、早い再訪を祈っておるぞ。"
                },
                {
                    "ID": 76,
                    "DefaultText": "もちろんだ。明日の夜にそなたがここにいなくとも、どこか同じように心地よい場所にいることを祈ろう。"
                },
                {
                    "ID": 77,
                    "DefaultText": "グロビアン、アンドレアスを無事に家まで送り届けてやってくれ。"
                },
                {
                    "ID": 78,
                    "DefaultText": "もちろんですとも、陛下。"
                },
                {
                    "ID": 79,
                    "DefaultText": "ではまた会おう、アンドレアス。"
                },
                {
                    "ID": 80,
                    "DefaultText": "では、またお会いする日まで、陛下。"
                },
                {
                    "ID": 81,
                    "DefaultText": "あの野郎の大修道院長が、なんで気にするってんだ？ あいつが気にしてるのは、あの若造から搾り取れる金だけだろうが。"
                },
                {
                    "ID": 82,
                    "DefaultText": "ここは大修道院長の家ですもの。誰もがあの方の決まり、というより、あの戒律に従わなければなりませんのよ。"
                },
                {
                    "ID": 83,
                    "DefaultText": "アンドレアスは、どちらの師の下でも同じようによく働けるじゃろう。ピエロ修道士から多くの導きを得られるという違いはあるがの。"
                }
            ]
        },
        {

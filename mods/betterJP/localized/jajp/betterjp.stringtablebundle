            "Entries": [
                {
                    "ID": 0,
                    "DefaultText": "ラテン語"
                },
                {
                    "ID": 1,
                    "DefaultText": "ラテン語の素養"
                },
                {
                    "ID": 2,
                    "DefaultText": "アンドレアスはラテン語の文法と語彙に長けている。また、共和政ローマや帝政ローマの格言を引用した、古の言葉をたやすく思い出すことができる。"
                },
                {
                    "ID": 3,
                    "DefaultText": "神学の素養"
                },
                {
                    "ID": 5,
                    "DefaultText": "アンドレアスは、カトリック神学や聖書の知識、教会法、異端、そのほか類似する分野に関する造詣が深い。"
                },
                {
                    "ID": 8,
                    "DefaultText": "論理学の素養"
                },
                {
                    "ID": 9,
                    "DefaultText": "論理学"
                },
                {
                    "ID": 10,
                    "DefaultText": "アンドレアスは受け取った情報の意図を意識せずとも考え、空間分析に長けており、頭の中で複雑な計算を難なく行える。"
                },
                {
                    "ID": 11,
                    "DefaultText": "弁論の素養"
                },
                {
                    "ID": 12,
                    "DefaultText": "アンドレアスは大学で修辞学が得意だった。彼は優れた教師であり、説得力があり、演説家だ。"
                },
                {
                    "ID": 13,
                    "DefaultText": "弁論"
                },
                {
                    "ID": 14,
                    "DefaultText": "数学の素養"
                },
                {
                    "ID": 17,
                    "DefaultText": "視覚的思考の素養"
                },
                {
                    "ID": 19,
                    "DefaultText": "アンドレアスは大学で数論幾何学と数学が得意だった。形や大きさ、量、距離に対する感覚が優れている。"
                },
                {
                    "ID": 20,
                    "DefaultText": "音楽の素養"
                },
                {
                    "ID": 21,
                    "DefaultText": "音楽"
                },
                {
                    "ID": 22,
                    "DefaultText": "アンドレアスは星座や天体、それらの動きに関する知識が豊富だ。また、研究や彼自身の経験のおかげで、さまざまな動植物にも詳しい。"
                },
                {
                    "ID": 23,
                    "DefaultText": "天文学の素養"
                },
                {
                    "ID": 24,
                    "DefaultText": "天文学"
                },
                {
                    "ID": 26,
                    "DefaultText": "帝国法の素養"
                },
                {
                    "ID": 28,
                    "DefaultText": "アンドレアスは、中退する前にエアフルト大学で法律を学んだ。カロリナ刑事法典以前に神聖ローマ帝国を治めていた、寄せ集めで断片的な法制度の基本を理解している。"
                },
                {
                    "ID": 29,
                    "DefaultText": "医学の素養"
                },
                {
                    "ID": 32,
                    "DefaultText": "天文学の素養"
                },
                {
                    "ID": 33,
                    "DefaultText": "天文学"
                },
                {
                    "ID": 35,
                    "DefaultText": "本の虫の気質"
                },
                {
                    "ID": 36,
                    "DefaultText": "アンドレアスは仕事以外の自由な時間をすべて使って、できるだけ多くの本を探して読書に勤しんでいる。"
                },
                {
                    "ID": 38,
                    "DefaultText": "実業家の気質"
                },
                {
                    "ID": 39,
                    "DefaultText": "実業家"
                },
                {
                    "ID": 44,
                    "DefaultText": "ポーランドの見聞"
                },
                {
                    "ID": 46,
                    "DefaultText": "アンドレアスはポーランド語を多少、チェコ語とハンガリー語を少し話せ、クラクフ、プラハ、ブダの文化の話題にもついていける。"
                },
                {
                    "ID": 47,
                    "DefaultText": "快楽主義"
                },
                {
                    "ID": 48,
                    "DefaultText": "快楽主義者の気質"
                },
                {
                    "ID": 49,
                    "DefaultText": "快楽主義"
                },
                {
                    "ID": 50,
                    "DefaultText": "アンドレアスは、どこへ行くにも楽しいことを求める。とても社交的で、この世のあらゆる愉しい悪習や道楽をかなり経験してきた。"
                },
                {
                    "ID": 51,
                    "DefaultText": "アンドレアスは、中退する前にエアフルト大学で法律を学んだ。カロリナ刑事法典以前に神聖ローマ帝国を治めていた、寄せ集めで断片的な法制度の基本を理解している。"
                },
                {
                    "ID": 53,
                    "DefaultText": "法律の素養"
                },
                {
                    "ID": 54,
                    "DefaultText": "一匹狼の気質"
                },
                {
                    "ID": 57,
                    "DefaultText": "アンドレアスは、修行の旅のほとんどをオランダ、フランドル、ベルギー、ルクセンブルクで過ごした。"
                },
                {
                    "ID": 61,
                    "DefaultText": "医学の素養"
                },
                {
                    "ID": 63,
                    "DefaultText": "ごろつきの気質"
                },
                {
                    "ID": 64,
                    "DefaultText": "ごろつき"
                },
                {
                    "ID": 67,
                    "DefaultText": "南海岸の見聞"
                },
                {
                    "ID": 68,
                    "DefaultText": "アンドレアスは、修行の旅のほとんどをイタリア、オクシタニア、スペイン、ギリシャで過ごした。"
                },
                {
                    "ID": 69,
                    "DefaultText": "島々"
                },
                {
                    "ID": 70,
                    "DefaultText": "島々の見聞"
                },
                {
                    "ID": 71,
                    "DefaultText": "アンドレアスは、修行の旅のほとんどをイギリス、アイルランド、ブルターニュ、ノルマンディーで過ごした。"
                },
                {
                    "ID": 72,
                    "DefaultText": "北方"
                },
                {
                    "ID": 73,
                    "DefaultText": "北方の見聞"
                },
                {
                    "ID": 74,
                    "DefaultText": "アンドレアスは、修行の旅のほとんどをデンマーク、スウェーデン、ノルウェーで過ごした。"
                },
                {
                    "ID": 77,
                    "DefaultText": "アンドレアスは、神聖ローマ帝国の諸領邦ごとに分かれた複雑な法体系の基本を知っている。"
                },
                {
                    "ID": 79,
                    "DefaultText": "アンドレアスはイタリア語とフランス語を少し話せ、バーゼルや近隣のベルン、チューリッヒ、フライブルクの文化に関する話題にも通じている。"
                },
                {
                    "ID": 81,
                    "DefaultText": "アンドレアスはオランダ語とフランス語を少し話せ、アントワープ、ブルージュ、ゲントの文化に関する話題にも通じている。"
                },
                {
                    "ID": 83,
                    "DefaultText": "アンドレアスはイタリア語が話せ、ギリシャ語も少しできる。フィレンツェ、ヴェネツィア、ミラノの文化に関する話題にも通じている。"
                },
                {
                    "ID": 84,
                    "DefaultText": "イングランド"
                },
                {
                    "ID": 85,
                    "DefaultText": "アンドレアスは英語を少し知っており、ロンドンやブリテン島の他の地域の文化に関する話題にも通じている。"
                },
                {
                    "ID": 86,
                    "DefaultText": "フランス"
                },
                {
                    "ID": 87,
                    "DefaultText": "アンドレアスはフランス語を知っており、パリ、トゥール、ディジョンの文化に関する話題にも通じている。"
                },
                {
                    "ID": 88,
                    "DefaultText": "アラゴン"
                },
                {
                    "ID": 89,
                    "DefaultText": "アンドレアスはスペイン語を少し、アラビア語もごく少し知っており、バルセロナやバレンシアの文化に関する話題にも通じている。"
                },
                {
                    "ID": 90,
                    "DefaultText": "大修道院を一人で出たとゲルノットに信じ込ませた。"
                },
                {
                    "ID": 95,
                    "DefaultText": "ピエロが有罪だという決めつけに異議を唱えた。"
                },

        },
        {
            "Name": "conversations/act3/act3_endris",
            "UObjectName": "act3_endris_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 4,
                    "DefaultText": "オットーを失った瞬間、彼らはもう終わっていた。彼こそが、皆をつなぎ止めるかすがいだったんだ。"
                },
                {
                    "ID": 22,
                    "DefaultText": "ペテロと農民たちに、何かを変えることはできたと思う？"
                },
                {
                    "ID": 24,
                    "DefaultText": "父は、町の人たちが農民の味方をしてくれなかったことが悔やまれると言ってた。あなたはどう思うの？"
                },
                {
                    "ID": 26,
                    "DefaultText": "あの夜、たくさんの人が死んだ。戦いを止める方法はなかったの？"
                },
                {
                    "ID": 44,
                    "DefaultText": "人々は努力した。君の父親の友人であるアンドレアス・マーラーは、並の人間以上に力を尽くしたよ。"
                },
                {
                    "ID": 48,
                    "DefaultText": "彼らの怒りが煮えたぎって溢れ出したら、もう何をしても止められなかっただろう。"
                },
                {
                    "ID": 51,
                    "DefaultText": "人と人との絆は脆い。人の命もそうだ。"
                },
                {
                    "ID": 52,
                    "DefaultText": "結局、正義の怒りなんて、喉元に突きつけられた刃の前では盾にならないんだ。"
                },
                {
                    "ID": 53,
                    "DefaultText": "その後は何をしていたの？ 戦いが収まってからは。"
                },
                {
                    "ID": 57,
                    "DefaultText": "鋼、金槌、金床...信頼できるものたちだ。"
                },
                {
                    "ID": 58,
                    "DefaultText": "それ以来、俺なりにうまくやってきたよ。もちろん、自慢するつもりはないがな。"
                },
                {
                    "ID": 59,
                    "DefaultText": "あなたの仕事は素晴らしいわ。父は、あなたが鋳造してくれた活字を高く評価しているの。"
                },
                {
                    "ID": 61,
                    "DefaultText": "バルタスと私の小さな機械だって、あなたがいなければ作れなかったわ。"
                },
                {
                    "ID": 63,
                    "DefaultText": "ハッ！ 君の父さんと一緒に仕事をして、忍耐についてはずいぶん学ばせてもらったよ。"
                },
                {
                    "ID": 64,
                    "DefaultText": "ハッ！ ああ、できなかったろうな。"
                },
                {
                    "ID": 65,
                    "DefaultText": "領主からの依頼のおかげで、あなたの帳簿はさぞ潤っているでしょうね。"
                },
                {
                    "ID": 66,
                    "DefaultText": "ハッ！ ああ、確かにうまくやってるよ。"
                },
                {
                    "ID": 68,
                    "DefaultText": "いずれにせよ、君の壁画がうまくいくことを願っている、マグダレネ。タッシングの誇りとなるものにしてくれ。"
                },
                {
                    "ID": 77,
                    "DefaultText": "今の領主は、大修道院長以上にタッシングのことなど気にかけていないし、その部下は修道士ほど臆病でもない。"
                },
                {
                    "ID": 81,
                    "DefaultText": "あの暴動は、それだけの価値があったんだろうか？ わからない。"
                },
                {
                    "ID": 85,
                    "DefaultText": "君も歳を取れば分かるさ。正しいと感じることは、その時々で変わっていくものだとね。"
                },
                {
                    "ID": 87,
                    "DefaultText": "だが、仕事に戻らなきゃならなかった。俺にはこの鍛冶場しかなかったからな。"
                },
                {
                    "ID": 89,
                    "DefaultText": "前と同じではなかったの？"
                },
                {
                    "ID": 92,
                    "DefaultText": "二度と元通りにはならないよ。"
                },
                {
                    "ID": 94,
                    "DefaultText": "この仕事のおかげで、なんとか生きてはいる。それにどれほどの値打ちがあるかは知らないがな。"
                },
                {
                    "ID": 96,
                    "DefaultText": "どんな命とも同じだけの価値があるわ。"
                },
                {
                    "ID": 97,
                    "DefaultText": "優しい子だな、マグダレネ。気遣いの言葉、ありがとう。"
                },
                {
                    "ID": 98,
                    "DefaultText": "暴動が俺たちに何か教えてくれたとすれば、命の値段なんてそれほど高くないってことさ。"
                },
                {
                    "ID": 102,
                    "DefaultText": "本当の教訓ってのは、そういうものさ。"
                },
                {
                    "ID": 104,
                    "DefaultText": "俺は恋人のレジ、つまりテレーゼを探しにインスブルックへ行ったんだ。大修道院が燃えたあと、そうせずにはいられなかった。"
                },
                {
                    "ID": 105,
                    "DefaultText": "あの頃は、人生がひどく短く感じられた。危うくて、脆くて。もしああしていたら、と思い悩んだまま死ぬのはごめんだったんだ。"
                },
                {
                    "ID": 119,
                    "DefaultText": "お父さんの友人だったアンドレアスのことを君が覚えているかどうかもわからないが、彼の芸術に対する情熱には俺も奮い立たされたんだ。"
                },
                {
                    "ID": 120,
                    "DefaultText": "彼は、本を救うためだけに火事で亡くなったの？"
                },
                {
                    "ID": 121,
                    "DefaultText": "奥さんを残して、悲しませたんじゃないの？ 不公平だわ。"
                },
                {
                    "ID": 122,
                    "DefaultText": "彼はあの本を、何よりも、誰よりも愛していたんじゃないかと思う。"
                },
                {
                    "ID": 125,
                    "DefaultText": "やあ、マグダレネ。クラウスの様子はどうだい？"
                },
                {
                    "ID": 133,
                    "DefaultText": "ゲルトルートは彼に会いに行ったか？ あの医者より彼女の方が信用できる。"
                },
                {
                    "ID": 134,
                    "DefaultText": "彼は信頼できない。"
                },
                {
                    "ID": 137,
                    "DefaultText": "そうなの？ いつも気難しいのに。"
                },
                {
                    "ID": 145,
                    "DefaultText": "父と私には彼しかいないの。どうしたらいいのかわからないの、エンドリス。"
                },
                {
                    "ID": 146,
                    "DefaultText": "噂話は慎むべきだな。"
                },
                {
                    "ID": 147,
                    "DefaultText": "俺にできることがあれば、何でも言ってくれ。"
                },
                {
                    "ID": 149,
                    "DefaultText": "彼は自分の仕事を気にしているか？ それはどうかな。"
                },
                {
                    "ID": 150,
                    "DefaultText": "年を追うごとに、ひどくなる一方だ。"
                },
                {
                    "ID": 151,
                    "DefaultText": "彼を襲ったのが誰だかわかったか？"
                },
                {
                    "ID": 154,
                    "DefaultText": "王の宮廷にこそふさわしい男だったのに。"
                },
                {
                    "ID": 155,
                    "DefaultText": "何が変わったの？"
                },
                {
                    "ID": 157,
                    "DefaultText": "暴動だ、間違いなく。みんなを変えたんだ。"
                },
                {
                    "ID": 159,
                    "DefaultText": "彼は冷酷な男じゃない、マグダレネ。同情に値するよ。"
                },
                {
                    "ID": 163,
                    "DefaultText": "たいしたことじゃないよ。"
                },
                {
                    "ID": 164,
                    "DefaultText": "俺は君の父親に、言葉では言い尽くせないほど恩があるんだ。"
                },
                {
                    "ID": 169,
                    "DefaultText": "なぜ彼は評議会にいるの？"
                },
                {
                    "ID": 172,
                    "DefaultText": "それでも多少は物を言うってことだろうさ。"
                },
                {
                    "ID": 173,
                    "DefaultText": "どこが公平なの？"
                },
                {
                    "ID": 176,
                    "DefaultText": "ああ、だが噂話は慎むべきだな。"
                },
                {
                    "ID": 193,
                    "DefaultText": "彼は面白い人だった。うぬぼれが強くておせっかいだったが、好きなものは心の底から愛する人だった。"
                },
                {
                    "ID": 194,
                    "DefaultText": "図書館があんなことになったのを見たら、彼はさぞ打ちのめされただろうな。"
                },
                {
                    "ID": 429,
                    "DefaultText": "ああ、マグダレネ。本当にお気の毒に。"
                },
                {
                    "ID": 431,
                    "DefaultText": "声はかけられたよ。断ったがな。"
                },
                {
                    "ID": 434,
                    "DefaultText": "...そうだといいんだがな。"
                },
                {
                    "ID": 437,
                    "DefaultText": "暴動が彼を変えたの？"
                },
                {
                    "ID": 441,
                    "DefaultText": "バルタスの新しい企てを手伝うのは、今すぐにはできないんだ。"
                },
                {
                    "ID": 443,
                    "DefaultText": "見に行ったが、帆布と足場ですっかり覆われていたな。"

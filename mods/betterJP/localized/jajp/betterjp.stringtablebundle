        {
            "Name": "conversations/act1/act1_marie_stsatia",
            "UObjectName": "act1_marie_stsatia_BaseGame_jajp",
            "Entries": [
                {
                    "ID": 9,
                    "DefaultText": "ちゃんと選べたかな？ 聖サティアに気に入ってもらえると思う？"
                },
                {
                    "ID": 12,
                    "DefaultText": "ああ、きれいな花束だね、ベルト。自分で集めたのかい？"
                },
                {
                    "ID": 13,
                    "DefaultText": "あら、アンドレアス・マーラー、それはこちらのセリフですよ！ 早めのお散歩ですか？"
                },
                {
                    "ID": 14,
                    "DefaultText": "<shake>うん！</shake>"
                },
                {
                    "ID": 19,
                    "DefaultText": "実はこの木がとても気になって...かなり大きいですね。"
                },
                {
                    "ID": 20,
                    "DefaultText": "殺人事件...のことですよね。すみません、忘れていました。大修道院は丘の上にあるから、時々すごく遠くにあるような気がするんですよ。"
                },
                {
                    "ID": 21,
                    "DefaultText": "この神聖な場所で、あなたの心が少しでも安らげばいいんですが...私にとってはそんな場所なんです。"
                },
                {
                    "ID": 23,
                    "DefaultText": "聖サティアに供えるのか？"
                },
                {
                    "ID": 24,
                    "DefaultText": "バーティの花のことでしょ？ それと、この秋最後のリンゴもね。"
                },
                {
                    "ID": 26,
                    "DefaultText": "アンドレアス、聖サティアの話はご存じですか？"
                },
                {
                    "ID": 28,
                    "DefaultText": "もうすでに気分が清々しくなったようです。ここは特別な場所なんですよね？"
                },
                {
                    "ID": 34,
                    "DefaultText": "あまり詳しく知らないんです。地元の聖人ということでしょうか？"
                },
                {
                    "ID": 35,
                    "DefaultText": "<whisper>手には聖なる槍を持ってるんだ！</whisper>"
                },
                {
                    "ID": 37,
                    "DefaultText": "こんな小さな山間の町からこんなに多くの聖人が輩出されるとは、普通ではないと思いませんか？"
                },
                {
                    "ID": 38,
                    "DefaultText": "[思慮深くうなずく]"
                },
                {
                    "ID": 40,
                    "DefaultText": "二人の聖人を「そんなに多く」と言っていいのかどうかわかりませんが..."
                },
                {
                    "ID": 50,
                    "DefaultText": "どんな果物なのですか？"
                },
                {
                    "ID": 52,
                    "DefaultText": "<shake>梨</shake>もだよ！"
                },
                {
                    "ID": 57,
                    "DefaultText": "最後は、サティアはどうなったのですか？"
                },
                {
                    "ID": 60,
                    "DefaultText": "彼女は今でも私たちと一緒にいると思うんです。そうよね、ベルト？"
                },
                {
                    "ID": 61,
                    "DefaultText": "きっと木の中だよ！"
                },
                {
                    "ID": 64,
                    "DefaultText": "彼女は今でも私たちと一緒にいると思うんです。そう思わない、ベルト？"
                },
                {
                    "ID": 65,
                    "DefaultText": "木だって？"
                },
                {
                    "ID": 72,
                    "DefaultText": "もしそうだとしたら、どうですか？"
                },
                {
                    "ID": 76,
                    "DefaultText": "大きくて、おいしいリンゴだよ！"
                },
                {
                    "ID": 78,
                    "DefaultText": "タッシングを地図上の名前としてしか知らない教会が、彼女らよりも詳しく知っているはずなどあるでしょうか？"
                },
                {
                    "ID": 79,
                    "DefaultText": "<red>主</red>の御業は人間の常識を越えています。あなたは主よりもよく分かっているとお思いなのですか？"
                },
                {
                    "ID": 80,
                    "DefaultText": "それは...そんなことはないでしょうね。"
                },
                {
                    "ID": 82,
                    "DefaultText": "[あからさまに沈黙を続ける]"
                },
                {
                    "ID": 83,
                    "DefaultText": "それは...そうではないでしょうね。"
                },
                {
                    "ID": 90,
                    "DefaultText": "ああ、それは...かなりプライベートなことなんです。ごめんなさい、話題に持ち出すべきじゃなかったわ。"
                },
                {
                    "ID": 91,
                    "DefaultText": "どういう意味ですか？"
                },
                {
                    "ID": 94,
                    "DefaultText": "ああ、これからも話を紡いでいきますわ！ アンドレアス、聞いてくれてありがとう。あなたが彼女の木の下で安らぎを見いだせたなら、とてもうれしいわ。"
                },
                {
                    "ID": 97,
                    "DefaultText": "<shake>さようなら！</shake>"
                },
                {
                    "ID": 104,
                    "DefaultText": "僕は<green>木</green>からやって来たんだ！"
                },
                {
                    "ID": 105,
                    "DefaultText": "だからそんなにワンパクなんだな！"
                },
                {
                    "ID": 115,
                    "DefaultText": "彼がご自身の考えに耳を傾けてくださることを期待しましょう！"
                },
                {
                    "ID": 121,
                    "DefaultText": "またね、ベルト！"
                },
                {
                    "ID": 122,
                    "DefaultText": "<shake>またね！</shake>"
                }
            ]
        },
